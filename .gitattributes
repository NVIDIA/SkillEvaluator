# Shell scripts run through their shebang inside Linux containers. Keep them
# LF so a Windows checkout cannot turn "#!/bin/bash" into "#!/bin/bash\r".
*.sh text eol=lf

# Vendored report assets are verified by digest; never convert their newlines.
src/skillevaluator/reporting/assets/** -text

# The captured JSON layout check compares exact LF output from scripts/layout_json.py.
tests/fixtures/skillspector-*.json text eol=lf
tests/fixtures/skillspector-*/*.json text eol=lf
tests/golden/cli_surface.json text eol=lf
tests/reporting/fixtures/*.json text eol=lf
tests/tier3/fixtures/*.json text eol=lf
