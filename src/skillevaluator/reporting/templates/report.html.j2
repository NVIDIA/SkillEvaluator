            .t3-sug-title { font-weight:800; color:var(--dark-text); display:flex; gap:0.55rem; align-items:center; flex-wrap:wrap; }
            .t3-sug-cat { display:inline-block; padding:0.1rem 0.45rem; border-radius:4px; font-size:0.68rem; font-weight:800; text-transform:uppercase; letter-spacing:0.04em; background:var(--bg-secondary); color:var(--secondary-color); border:1px solid var(--border-color); }
            .t3-sug-actions { display:flex; gap:0.35rem; }
            .t3-copy-btn { background:var(--bg-secondary); border:1px solid var(--border-color); border-radius:6px; padding:0.25rem 0.55rem; font-size:0.72rem; font-weight:700; color:var(--text-secondary); cursor:pointer; }
            .t3-copy-btn:hover { color:var(--dark-text); background:var(--bg); }
            .t3-copy-btn.copied { color:var(--success-color); border-color:var(--success-color); }

            /* Provenance key-value grid */
            .t3-prov-grid { display:grid; grid-template-columns:minmax(140px, 0.3fr) 1fr auto; gap:0.4rem 0.85rem; align-items:center; padding:0.25rem 0; }
            .t3-prov-grid .t3-prov-label { font-weight:700; color:var(--dark-text); font-size:0.85rem; padding:0.4rem 0; }
            .t3-prov-grid .t3-prov-value { font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-size:0.8rem; color:var(--text-secondary); background:var(--bg-secondary); padding:0.45rem 0.65rem; border-radius:6px; word-break:break-all; }
            .t3-prov-grid .t3-prov-action { display:flex; gap:0.4rem; }
            .t3-download-grid { display:flex; flex-wrap:wrap; gap:0.5rem; }
            .t3-download-grid .t3-copy-btn { padding:0.4rem 0.85rem; font-size:0.78rem; }
            .t3-truncation-notice { background:var(--badge-warn-bg); border:1px solid var(--warning-color); border-left:4px solid var(--warning-color); border-radius:10px; color:var(--dark-text); margin:0 0 1rem; padding:0.8rem 1rem; }
            .t3-truncation-notice strong { display:block; margin-bottom:0.3rem; }
            .t3-truncation-notice ul { display:flex; flex-wrap:wrap; gap:0.25rem 1rem; margin:0.35rem 0 0; padding-left:1.2rem; font-size:0.82rem; color:var(--text-secondary); }
            /* Insight source tag (deterministic vs LLM) */
            .t3-insight-source { display:inline-block; padding:0.05rem 0.4rem; border-radius:4px; font-size:0.65rem; font-weight:800; text-transform:uppercase; letter-spacing:0.04em; vertical-align:middle; margin-left:0.35rem; }
            .insight-source-deterministic { background:var(--bg-secondary); color:var(--text-secondary); border:1px solid var(--border-color); }
            .insight-source-llm { background:rgba(139,92,246,0.18); color:#8b5cf6; border:1px solid rgba(139,92,246,0.4); }
            /* Reasoning column wraps at a comfortable width */
            .t3-reasoning { font-size:0.85rem; color:var(--dark-text); max-width:520px; line-height:1.45; white-space:normal; }
            .t3-reasoning-list { margin:0; padding-left:1.05rem; }
            .t3-reasoning-list li { margin-bottom:0.2rem; }
            .t3-reasoning-list li:last-child { margin-bottom:0; }
            /* One-liner hint shown beneath a dimension name in tables */
            .t3-dim-hint { color:var(--text-secondary); font-size:0.78rem; font-weight:400; margin-top:0.15rem; line-height:1.35; }
            /* Reusable section hint paragraph used above several Tier 3 tables */
            .t3-section-hint { color:var(--text-secondary); font-size:0.85rem; margin:0 0 0.75rem; }
            /* Multi-Agent Dimension Lift cell layout */
            .t3-mad-cell { display:flex; flex-direction:column; align-items:flex-start; gap:0.2rem; min-width:84px; }
            .t3-mad-score-row { display:flex; align-items:center; gap:0.45rem; width:100%; }
            .t3-mad-score { font-weight:700; font-variant-numeric:tabular-nums; }
            .t3-mad-bar { flex:1; height:6px; min-width:48px; background:var(--bg-tertiary); border-radius:999px; overflow:hidden; }
            .t3-mad-bar > span { display:block; height:100%; border-radius:999px; }
            .t3-mad-lift { font-size:0.74rem; font-weight:700; font-variant-numeric:tabular-nums; }
            /* Tier summary chip strip on the global hero */
            .agent-hero-tiers { display:flex; flex-wrap:wrap; gap:0.5rem; margin-top:0.65rem; }
            .agent-hero-tier-chip { background:var(--bg-secondary); border:1px solid var(--border-color); border-radius:999px; padding:0.2rem 0.65rem; font-size:0.78rem; color:var(--text-secondary); }
            .agent-hero-tier-chip strong { color:var(--dark-text); }
            .agent-hero-tier-chip.pass strong { color:var(--success-color); }
            .agent-hero-tier-chip.fail strong { color:var(--danger-color); }
            .agent-hero-tier-chip.warn strong { color:var(--warning-color); }

            /* Search/filter input */
            .t3-filter-bar { display:flex; gap:0.5rem; align-items:center; margin:0 0 0.85rem; flex-wrap:wrap; }
            .t3-filter-input { flex:1; min-width:220px; padding:0.5rem 0.75rem; border:1px solid var(--border-color); border-radius:8px; background:var(--bg); color:var(--dark-text); font-size:0.88rem; }
            .t3-filter-input:focus { outline:none; border-color:var(--secondary-color); box-shadow:0 0 0 2px rgba(118,185,0,0.15); }
            .t3-filter-count { font-size:0.78rem; color:var(--text-secondary); font-weight:600; }

            /* Print-friendly */
            @media print {
                .t3-subtabs, .t3-agent-tabs, .t3-copy-btn, .t3-filter-bar { display:none !important; }
                .t3-page, .t3-agent-panel { display:block !important; page-break-inside:avoid; }
                .t3-eval-card, .t3-sug-card, .t3-kpi-card, .t3-pivot-wrap, .t3-lift-agent-block { page-break-inside:avoid; box-shadow:none; }
                .t3-details { box-shadow:none; }
                .t3-details > summary::after { display:none; }
                .t3-eval-evidence { display:block; }
                .t3-eval-evidence > summary { display:none; }
            }
        </style>

        <nav class="t3-subtabs">
            <button class="t3-subtab active" data-tier3-tab="overview" onclick="showTier3SubTab('overview', this)">Overview</button>
            <button class="t3-subtab" data-tier3-tab="suggestions" onclick="showTier3SubTab('suggestions', this)">Insights</button>
            <button class="t3-subtab" data-tier3-tab="agents" onclick="showTier3SubTab('agents', this)">Agent Details</button>
            <button class="t3-subtab" data-tier3-tab="trials" onclick="showTier3SubTab('trials', this)">Trials</button>
            <button class="t3-subtab" data-tier3-tab="dataset" onclick="showTier3SubTab('dataset', this)">Dataset</button>
            <button class="t3-subtab" data-tier3-tab="provenance" onclick="showTier3SubTab('provenance', this)">Diagnostics</button>
        </nav>

        {% if tier3_truncation or tier3_preview_notice %}
        <div class="t3-truncation-notice" role="status">
            <strong>Embedded report details were bounded.</strong>
            {% if tier3_truncation %}
            <span>The canonical payload omits bounded diagnostic details; retained Harbor artifacts remain available from the run directory.</span>
            {% endif %}
            {% if tier3_preview_notice %}
            <span>
                HTML preview omitted
                {% if tier3_preview_notice.characters %}{{ tier3_preview_notice.characters }} characters{% endif %}
                {% if tier3_preview_notice.characters and tier3_preview_notice.items %} and {% endif %}
                {% if tier3_preview_notice.items %}{{ tier3_preview_notice.items }} items{% endif %}.
                JSON Downloads preserve the complete bounded canonical payload.
            </span>
            {% endif %}
            {% if tier3_truncation.omitted %}
            <ul>
                {% for section, count in tier3_truncation.omitted.items() %}
                <li>{{ section | replace('_', ' ') }} omitted: {{ count }}</li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        {% endif %}

        {# ---------- Overview ---------- #}
        <section class="t3-page active" id="tier3-page-overview">
            <div class="t3-overview-lead">
                {% if tier3_is_skipped %}
                <strong>Live evaluation skipped:</strong> {{ tier3_skip_message }}
                Tier 3 is advisory and does not block required validation.
                {% else %}
                <strong>Verdict at a glance:</strong>
                {{ (tier3.verdict or 'unknown') | upper }} with an overall score of
                {{ "%.2f" | format(tier3.overall_score) if tier3.overall_score is not none else "N/A" }}.
                {% if t3_best_name %}Best performing agent is <strong>{{ t3_best_name }}</strong>{% else %}No successfully scored agent is available{% endif %}
                {% if tier3.get('overall_lift') is not none %} with {{ "%+.2f" | format(tier3.get('overall_lift')) }} skill lift{% endif %}.
                {% endif %}
            </div>
            {% if t3_harbor_job_url or t3_harbor_analysis_url %}
            <div class="t3-harbor-panel">
                <div>
                    <strong>Harbor artifacts</strong>
                    <p>Open retained logs, raw trajectories, artifacts, and generated Harbor analysis for this Tier 3 run.</p>
                </div>
                <div class="t3-harbor-actions">
                    {% if t3_harbor_job_url %}<a class="t3-harbor-link" href="{{ t3_harbor_job_url }}" target="_blank" rel="noopener">Open Harbor logs</a>{% endif %}
                    {% if t3_harbor_analysis_url %}<a class="t3-harbor-link" href="{{ t3_harbor_analysis_url }}" target="_blank" rel="noopener">Open Harbor analysis</a>{% endif %}
                </div>
            </div>
            {% endif %}
            <div class="dashboard">
                <div class="dashboard-card {{ 'success' if tier3.verdict == 'pass' else ('danger' if tier3.verdict == 'fail' else '') }}">
                    <h3 class="dashboard-card-title">Verdict</h3>
                    <p class="dashboard-card-value">{{ 'SKIPPED' if tier3_is_skipped else (tier3.verdict or 'unknown') | upper }}</p>
                    <p class="dashboard-card-subtitle">Evaluation outcome</p>
                </div>
                <div class="dashboard-card">
                    <h3 class="dashboard-card-title">Overall Score</h3>
                    <p class="dashboard-card-value">{{ "%.2f" | format(tier3.overall_score) if tier3.overall_score is not none else "N/A" }}</p>
                    <p class="dashboard-card-subtitle">Best run across evaluated dimensions</p>
                </div>
                <div class="dashboard-card">
                    <h3 class="dashboard-card-title">Best Performing Agent</h3>
                    <p class="dashboard-card-value" style="font-size:1.35rem;">{{ t3_best_name or 'N/A' }}</p>
                    <p class="dashboard-card-subtitle">Score {{ "%.2f" | format(t3_best.with_skill) if t3_best and t3_best.with_skill is not none else "N/A" }}</p>
                </div>
                <div class="dashboard-card">
                    <h3 class="dashboard-card-title">Skill Lift</h3>
                    <p class="dashboard-card-value">{{ "%+.2f" | format(tier3.get('overall_lift')) if tier3.get('overall_lift') is not none else "N/A" }}</p>
                    <p class="dashboard-card-subtitle">Compared with baseline</p>
                </div>
            </div>

            {% set t3_preview_conclusion = (tier3.conclusions[0] if tier3.conclusions and (tier3.conclusions | length) > 0 else None) %}
            {% set t3_preview_recommendations = tier3.recommendations or [] %}
            {% set t3_preview_suggestions = tier3.suggestions or [] %}
            <div class="t3-next-steps" id="tier3-next-steps-preview">
                <div class="t3-next-steps-head">
                    <h3>Conclusion &amp; Next Steps</h3>
                    <button class="t3-link-btn" type="button" onclick="showTier3SubTab('suggestions', document.querySelector('.t3-subtab[data-tier3-tab=&quot;suggestions&quot;]'))">Open Full Insights</button>
                </div>
                {% if t3_preview_conclusion %}
                <p class="t3-next-steps-conclusion">
                    {{ t3_preview_conclusion.message if t3_preview_conclusion.message is defined and t3_preview_conclusion.message else t3_preview_conclusion }}
                </p>
                {% endif %}
                {% if t3_preview_recommendations %}
                <ol class="t3-next-steps-list">
                    {% for reco in t3_preview_recommendations[:3] %}
                    <li>
                        {{ reco.message if reco.message is defined and reco.message else reco }}
                        {% if reco.evidence and reco.evidence.url %}
                        <a class="t3-evidence-link" href="{{ reco.evidence.url }}" target="_blank" rel="noopener">View {{ reco.evidence.label or 'evidence' }}</a>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ol>
                {% elif t3_preview_suggestions %}
                <ol class="t3-next-steps-list">
                    {% for suggestion in t3_preview_suggestions[:3] %}
                    <li>{{ suggestion }}</li>
                    {% endfor %}
                </ol>
                {% else %}
                <p class="t3-next-steps-conclusion">No recommendations were generated for this evaluation.</p>
                {% endif %}
            </div>

            {% if tier3.dimensions %}
            <details class="t3-details" id="tier3-dimension-lift" open>
                <summary>Dimension Scores and Skill Lift (Best Performing Agent: {{ t3_best_name or 'N/A' }})</summary>
                <div class="t3-details-body">
                <p style="color:var(--text-secondary);font-size:0.85rem;margin-top:0;margin-bottom:0.75rem;">
                    Consolidated evaluation dimensions. The Signals column shows which evaluator metrics feed each human-readable dimension.
                </p>
                <div class="table-scroll">
                <table class="summary-table">
                    <thead><tr>
                        <th>Dimension</th><th>Score</th>
                        <th>Baseline</th><th>Skill Lift</th>
                        <th>Verdict</th><th>Signals</th><th>Reasoning</th>
                    </tr></thead>
                    <tbody>
                    {% for dim in tier3.dimensions %}
                    {% set dim_score = dim.score if dim.score is not none else dim.with_skill %}
                    {% set dim_color = 'var(--success-color)' if dim_score >= 0.7 else ('var(--warning-color)' if dim_score >= 0.4 else 'var(--danger-color)') %}
                    <tr>
                        <td>
                            <strong>{{ "Skill Efficiency" if dim.id == "efficiency" else (dim.id | title) }}</strong>
                            {% if t3_dim_hints.get(dim.id) %}<div class="t3-dim-hint">{{ t3_dim_hints.get(dim.id) }}</div>{% endif %}
                        </td>
                        <td>
                            <div class="metric-bar-cell">
                                <span class="metric-value" style="color:{{ dim_color }}">{{ "%.2f" | format(dim_score) }}</span>
                                <div class="mini-bar"><span style="width:{{ (dim_score * 100) | round(0) }}%; background:{{ dim_color }};"></span></div>
                            </div>
                        </td>
                        <td>{{ "%.2f" | format(dim.baseline) if dim.baseline is not none else "N/A" }}</td>
                        <td style="color:{{ 'var(--success-color)' if dim.lift is not none and dim.lift >= tier3_lift_pass_threshold else ('var(--danger-color)' if dim.lift is not none and dim.lift <= tier3_lift_fail_threshold else 'var(--text-secondary)') }};font-weight:600;">
                            {{ "%+.2f" | format(dim.lift) if dim.lift is not none else "N/A" }}
                        </td>
                        <td><span class="t3-pill {{ 'ok' if dim.verdict == 'PASS' else ('critical' if dim.verdict == 'FAIL' else 'warning') }}">{{ dim.verdict }}</span></td>
                        <td>
                            {% for metric_id in dim.evaluators or [] %}
                            <span class="metadata-tag">{{ t3_metric_labels.get(metric_id, metric_id | replace("_", " ") | title) }}</span>
                            {% endfor %}
                        </td>
                        <td class="t3-reasoning">
                            {% if dim.reasoning_bullets %}
                            <ul class="t3-reasoning-list">
                                {% for bullet in dim.reasoning_bullets %}<li>{{ bullet }}</li>{% endfor %}
                            </ul>
                            {% else %}
                            {{ dim.explanation if dim.explanation else "" }}
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
                </div>
            </details>

            {% if t3_agents | length > 1 %}
            <details class="t3-details" open>
                <summary>Multi-Agent Dimension Lift</summary>
                <div class="t3-details-body">
                <p class="t3-section-hint">
                    Per-dimension comparison across agents. The top number in each cell is the
                    with-skill score (with a mini-bar); the smaller line below is the skill lift
                    versus that agent's baseline.
                </p>
                {# Build {agent_name: {dim_id: dim_dict}} so each cell is a quick lookup. #}
                {% set t3_mad_by_agent = {} %}
                {% for name, agent in t3_agents.items() %}
                    {% set dmap = {} %}
                    {% for dim in agent.dimensions or [] %}{% set _ = dmap.update({dim.id: dim}) %}{% endfor %}
                    {% set _ = t3_mad_by_agent.update({name: dmap}) %}
                {% endfor %}
                <div class="table-scroll">
                <table class="summary-table" style="width:100%;">
                    <thead><tr>
                        <th>Dimension</th>
                        {% for name, _agent in t3_agents.items() %}
                        <th><button class="t3-agent-link" type="button" data-tier3-agent-link="{{ t3_agent_anchor_ids[name] }}" onclick="jumpToTier3Agent('{{ t3_agent_anchor_ids[name] }}')">{{ name }}</button></th>
                        {% endfor %}
                    </tr></thead>
                    <tbody>
                    {% for dim_id in t3_dim_ids %}
                        <tr>
                            <td>
                                <strong>{{ dim_id | title }}</strong>
                                {% if t3_dim_hints.get(dim_id) %}<div class="t3-dim-hint">{{ t3_dim_hints.get(dim_id) }}</div>{% endif %}
                            </td>
                            {% for name, _agent in t3_agents.items() %}
                                {% set d = t3_mad_by_agent[name].get(dim_id) %}
                                {% if d %}
                                    {% set d_score = d.score if d.score is not none else d.with_skill %}
                                    {% set d_lift = d.lift %}
                                    {% set d_color = 'var(--text-secondary)' if d_score is none else ('var(--success-color)' if d_score >= 0.7 else ('var(--warning-color)' if d_score >= 0.4 else 'var(--danger-color)')) %}
                                    {% set lift_color = 'var(--success-color)' if d_lift is not none and d_lift >= tier3_lift_pass_threshold else ('var(--danger-color)' if d_lift is not none and d_lift <= tier3_lift_fail_threshold else 'var(--text-secondary)') %}
                                    <td>
                                        <div class="t3-mad-cell">
                                            <div class="t3-mad-score-row">
                                                <span class="t3-mad-score" style="color:{{ d_color }};">{{ "%.2f" | format(d_score) if d_score is not none else "N/A" }}</span>
                                                {% if d_score is not none %}<div class="t3-mad-bar"><span style="width:{{ (d_score * 100) | round(0) }}%; background:{{ d_color }};"></span></div>{% endif %}
                                            </div>
                                            <span class="t3-mad-lift" style="color:{{ lift_color }};">{% if d_lift is not none %}{{ "%+.2f" | format(d_lift) }} lift{% elif d_score is none and d.baseline is not none %}with-skill unavailable{% elif d_score is none %}N/A lift{% else %}no baseline lift{% endif %}</span>
                                        </div>
                                    </td>
                                {% else %}
                                    <td style="color:var(--text-secondary);">N/A</td>
                                {% endif %}
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    <tr>
                        <td><strong>Overall</strong></td>
                        {% for name, agent in t3_agents.items() %}
                            {% set ws = agent.with_skill %}
                            {% set bl = agent.baseline %}
                            {% set lf = agent.lift %}
                            {% set ws_color = 'var(--text-secondary)' if ws is none else ('var(--success-color)' if ws >= 0.7 else ('var(--warning-color)' if ws >= 0.4 else 'var(--danger-color)')) %}
                            {% set lf_color = 'var(--success-color)' if lf is not none and lf >= tier3_lift_pass_threshold else ('var(--danger-color)' if lf is not none and lf <= tier3_lift_fail_threshold else 'var(--text-secondary)') %}
                            <td>
                                <div class="t3-mad-cell">
                                    <div class="t3-mad-score-row">
                                        <span class="t3-mad-score" style="color:{{ ws_color }};">{{ "%.2f" | format(ws) if ws is not none else "N/A" }}</span>
                                        {% if ws is not none %}<div class="t3-mad-bar"><span style="width:{{ (ws * 100) | round(0) }}%; background:{{ ws_color }};"></span></div>{% endif %}
                                    </div>
                                    <span class="t3-mad-lift" style="color:{{ lf_color }};">{% if lf is not none %}{{ "%+.2f" | format(lf) }} lift{% elif ws is none and bl is not none %}with-skill unavailable{% elif ws is none %}N/A lift{% else %}no baseline lift{% endif %}</span>
                                </div>
                            </td>
                        {% endfor %}
                    </tr>
                    </tbody>
                </table>
                </div>
                </div>
            </details>
            {% endif %}

            {% endif %}

            {% if t3_agents %}
            <details class="t3-details" open>
                <summary>Agent Scorecards</summary>
                <div class="t3-details-body">
                <div class="t3-agent-scorecards-row">
                    <div class="t3-agent-scorecard-list">
                    {% for name, agent in t3_agents.items() %}
                        {% set with_skill = agent.with_skill %}
                        {% set lift = agent.lift %}
                        {% set score_color = 'var(--text-secondary)' if with_skill is none else ('var(--success-color)' if with_skill >= 0.7 else ('var(--warning-color)' if with_skill >= 0.4 else 'var(--danger-color)')) %}
                        {% set card_lift_color = 'var(--text-secondary)' if lift is none else ('var(--success-color)' if lift >= tier3_lift_pass_threshold else ('var(--danger-color)' if lift <= tier3_lift_fail_threshold else 'var(--text-secondary)')) %}
                        <div class="t3-agent-card t3-agent-deeplink"
                             role="button"
                             tabindex="0"
                             data-tier3-agent-link="{{ t3_agent_anchor_ids[name] }}"
                             onclick="jumpToTier3Agent('{{ t3_agent_anchor_ids[name] }}')"
                             onkeydown="tier3MaybeActivateAgentLink(event, '{{ t3_agent_anchor_ids[name] }}')"
                             aria-label="Open Agent Details for {{ name }}"
                             title="Open Agent Details for {{ name }}">
                            <div class="t3-agent-name">{{ name }}</div>
                            <div class="t3-agent-score" style="color:{{ score_color }};">{{ "%.2f" | format(with_skill) if with_skill is not none else "N/A" }}</div>
                            <div style="color:{{ card_lift_color }};font-size:0.85rem;">
                                {% if lift is not none %}{{ "%+.2f" | format(lift) }} lift{% elif with_skill is none and agent.baseline is not none %}with-skill unavailable{% elif with_skill is none %}N/A lift{% else %}no baseline{% endif %}
                            </div>
                            <div style="color:var(--text-secondary);font-size:0.75rem;margin-top:0.25rem;">{{ agent.num_trials or 0 }} trials</div>
                            {% if with_skill is not none %}<div class="t3-mini-bar"><span style="width:{{ (with_skill * 100) | round(0) }}%; background:{{ score_color }};"></span></div>{% endif %}
                        </div>
                    {% endfor %}
                    </div>
                    <div class="chart-card"><h3>Dimension Comparison (Radar)</h3><canvas id="tier3-radar" height="260"></canvas></div>
                    <div class="chart-card"><h3>Dimension Scores by Agent</h3><canvas id="tier3-metric-bar" height="260"></canvas></div>
                </div>
                </div>
            </details>
            {% endif %}

        </section>

        {# ---------- Trials ---------- #}
        <section class="t3-page" id="tier3-page-trials">
            {% set t3_eval_ids = [] %}
            {% set t3_trial_score_keys = [] %}
            {% for trial in tier3.trials or [] %}
                {% for score_map in [trial.scores, trial.baseline_scores, trial.lift_scores] %}
                    {% if score_map is mapping %}
                        {% for metric_id in score_map.keys() %}
                            {% if metric_id not in t3_trial_score_keys %}
                                {% set _ = t3_trial_score_keys.append(metric_id) %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            {% endfor %}
            {% for metric_id in t3_metric_ids %}
                {% if metric_id in t3_trial_score_keys %}
                    {% set _ = t3_eval_ids.append(metric_id) %}
                {% endif %}
            {% endfor %}
            {% if not t3_eval_ids and not t3_trial_score_keys %}{% set t3_eval_ids = t3_metric_ids %}{% endif %}

            {# Pass@K is hoisted to the top of Trials so the rate sits immediately above
               the Trial Charts and per-case Attempt Details that explain it.
               Hiding it from Overview keeps the first-page beginner narrative focused. #}
            {% if tier3.pass_at_k and tier3.pass_at_k.with_skill %}
            <details class="t3-details" id="tier3-pass-at-k" open>
                <summary>Pass@{{ t3_max_attempts }} Summary</summary>
                <div class="t3-details-body">
                <p style="color:var(--text-secondary);font-size:0.85rem;margin:0 0 0.75rem;">
                    Pass@{{ t3_max_attempts }} reports the share of evaluation cases the agent solved within
                    {{ t3_max_attempts }} attempt{{ 's' if t3_max_attempts != 1 else '' }}, where a case counts as
                    "passed" only if the trial score reaches the configured pass threshold (currently
                    {{ "%.2f" | format(t3_attempt_policy.pass_threshold or 0.5) }}).
                    Higher rates and a positive lift show better observed repeatability on these evaluated cases.
                </p>
                <div class="table-scroll" tabindex="0" role="region" aria-label="Pass at K summary table">
                <table class="summary-table pass-at-k-table" style="width:100%;">
                    <thead><tr>
                        <th>Agent</th><th>Condition</th><th>Pass Rate</th><th>95% Interval</th><th>Cases Passed</th><th>Scored Attempts</th><th>Lift</th>
                    </tr></thead>
                    <tbody>
                    {% for name, agent in t3_agents.items() %}
                        {% set pak = agent.pass_at_k or {} %}
                        {% set wp = pak.with_skill or {} %}
                        {% set bp = pak.without_skill or {} %}
                        {% set lf = pak.lift or {} %}
                        {% set wi = wp.rate_interval or {} %}
                        {% set bi = bp.rate_interval or {} %}
                        {% set paired = lf.paired_comparison or {} %}
                        {% if wp %}
                        <tr>
                            <td><strong>{{ name }}</strong></td>
                            <td>With skill</td>
                            <td>{{ "%.0f%%" | format((wp.rate or 0.0) * 100) }}</td>
                            <td>{% if wi %}{{ wi | adaptive_interval_percent }}{% else %}—{% endif %}</td>
                            <td>{{ wp.passed_cases or 0 }} of {{ wp.total_cases or 0 }}</td>
                            <td>{{ wp.attempts_used or 0 }} of {{ wp.max_attempts_possible or 0 }}</td>
                            <td style="color:{{ 'var(--success-color)' if (lf.delta or 0) >= tier3_lift_pass_threshold else ('var(--danger-color)' if (lf.delta or 0) <= tier3_lift_fail_threshold else 'var(--text-secondary)') }};font-weight:600;">
                                {% if lf.delta is defined %}{{ "%+.0f%%" | format((lf.delta or 0.0) * 100) }}{% else %}—{% endif %}
                            </td>
                        </tr>
                        {% endif %}
                        {% if bp %}
                        <tr>
                            <td></td>
                            <td>Without skill</td>
                            <td>{{ "%.0f%%" | format((bp.rate or 0.0) * 100) }}</td>
                            <td>{% if bi %}{{ bi | adaptive_interval_percent }}{% else %}—{% endif %}</td>
                            <td>{{ bp.passed_cases or 0 }} of {{ bp.total_cases or 0 }}</td>
                            <td>{{ bp.attempts_used or 0 }} of {{ bp.max_attempts_possible or 0 }}</td>
                            <td>baseline</td>
                        </tr>
                        {% endif %}
                        {% if paired %}
                        <tr>
                            <td></td>
                            <td colspan="6" style="color:var(--text-secondary);font-size:0.82rem;">
                                {% if paired.paired_cases %}
                                Paired cases: {{ paired.paired_cases or 0 }}
                                (skill-only passes {{ paired.with_skill_only_pass or 0 }},
                                baseline-only passes {{ paired.without_skill_only_pass or 0 }},
                                both pass {{ paired.both_pass or 0 }}, neither pass {{ paired.neither_pass or 0 }}).
                                Pairing: {{ paired.pairing_status or 'unavailable' }}.
                                {% if paired.paired_rate_delta is defined and paired.paired_rate_delta is not none %}
                                Paired pass-rate delta: {{ paired.paired_rate_delta | adaptive_percent(true) }}.
                                {% endif %}
                                {% if paired.mcnemar_exact %}
                                Exact McNemar p={% if paired.mcnemar_exact.p_value_text is defined %}{{ paired.mcnemar_exact.p_value_text }}{% else %}{{ "%.4g" | format(paired.mcnemar_exact.p_value) }}{% endif %}.
                                {% if paired.mcnemar_exact.minimum_attainable_p_value is defined %}
                                Minimum attainable p with {{ paired.discordant_cases or 0 }} observed discordant pair{{ 's' if (paired.discordant_cases or 0) != 1 else '' }}: {% if paired.mcnemar_exact.minimum_attainable_p_value_text is defined %}{{ paired.mcnemar_exact.minimum_attainable_p_value_text }}{% else %}{{ "%.4g" | format(paired.mcnemar_exact.minimum_attainable_p_value) }}{% endif %}{% if paired.mcnemar_exact.resolution_limited_at_alpha_0_05 %}
                                (resolution-limited at α=0.05){% endif %}.
                                {% endif %}
                                Diagnostic only.
                                {% endif %}
                                {% else %}
                                Paired comparison {{ paired.pairing_status or 'unavailable' }}; exact test not computed.
                                {% endif %}
                            </td>
                        </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
                </div>
                </div>
            </details>
            {% endif %}

            {% if tier3.trials %}

            {# Charts moved above the heatmap so the visualization narrative is summary-chart -> pivot -> drill-down #}
            <details class="t3-details" open>
                <summary>Trial Charts</summary>
                <div class="t3-details-body">
                <div class="chart-grid">
                    <div class="chart-card"><h3>Token Usage by Agent</h3><canvas id="tier3-token-chart" height="250"></canvas></div>
                    <div class="chart-card"><h3>Steps per Eval Case</h3><canvas id="tier3-steps-chart" height="250"></canvas></div>
                </div>
                </div>
            </details>

            {# ----- Attempt Details: SkillEvaluator-style per-case attempt-score breakdown ----- #}
            {% set t3_pass_threshold = (t3_attempt_policy.pass_threshold if t3_attempt_policy.pass_threshold is not none else 0.5) | float %}
            {% set t3_attempt_rows = [] %}
            {% if t3_agents %}
                {% for agent_name, agent in t3_agents.items() %}
                    {% set pak = agent.pass_at_k or {} %}
                    {% for cond_label, branch in [('With skill', pak.with_skill), ('Without skill', pak.without_skill)] %}
                        {% if branch is mapping and branch.get('cases') %}
                            {% for case_id, case_data in branch.cases.items() %}
                                {% set _ = t3_attempt_rows.append({'agent': agent_name, 'condition': cond_label, 'case_id': case_id, 'case': case_data}) %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            {% endif %}

            {% if t3_attempt_rows %}
            <details class="t3-details" id="tier3-attempt-details" open>
                <summary>Attempt Details</summary>
                <div class="t3-details-body">
                <p class="t3-section-hint">
                    Each row is one eval case for one agent under one condition. Attempt Scores
                    lists the scored attempts only; a score at or above
                    {{ "%.2f" | format(t3_pass_threshold) }} counts as passed for Pass@{{ t3_max_attempts }}.
                    "Not scored" means no reward was found for that expected attempt; it is excluded from pass/fail.
                </p>
                <div class="t3-filter-bar">
                    <input class="t3-filter-input" type="search" placeholder="Filter by agent, case, condition, score..." oninput="tier3FilterTable(this, 't3-attempts-table')" aria-label="Filter attempt details">
                    <span class="t3-filter-count" data-tier3-filter-count="t3-attempts-table">{{ t3_attempt_rows | length }} / {{ t3_attempt_rows | length }}</span>
                </div>
                <div class="table-scroll">
                <table class="summary-table" id="t3-attempts-table">
                    <thead><tr>
                        <th>Agent</th><th>Condition</th><th>Eval Case</th>
                        <th>Attempt Scores</th><th>Scored Attempts</th>
                        <th>Best Score</th><th>Result</th>
                    </tr></thead>
                    <tbody>
                    {% for row in t3_attempt_rows %}
                        {% set case_data = row.case %}
                        {% set attempts = case_data.get('attempts') or [] %}
                        {% set attempts_used_value = case_data.get('attempts_used') %}
                        {% set attempts_missing_value = case_data.get('attempts_missing') %}
                        {% set attempts_skipped_value = case_data.get('attempts_skipped') %}
                        {% set attempts_used = attempts_used_value | int if attempts_used_value is not none else (attempts | length) %}
                        {% set attempts_missing = attempts_missing_value | int if attempts_missing_value is not none else 0 %}
                        {% set attempts_skipped = attempts_skipped_value | int if attempts_skipped_value is not none else 0 %}
                        {% set total_expected = attempts_used + attempts_missing + attempts_skipped %}
                        {% if total_expected == 0 %}{% set total_expected = t3_max_attempts %}{% endif %}
                        {% set best_score = case_data.get('best_score') %}
                        {% set passed = case_data.get('passed') %}
                        {% set first_pass_attempt = case_data.get('first_pass_attempt') %}
                        <tr>
                            <td><strong>{{ row.agent }}</strong></td>
                            <td>{{ row.condition }}</td>
                            <td style="font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:0.82rem;">{{ row.case_id }}</td>
                            <td>
                                {% if attempts %}
                                <div class="t3-attempt-list">
                                    {% for att in attempts %}
                                        {% set sc = att.get('score') %}
                                        {% set att_idx_value = att.get('attempt') %}
                                        {% set att_idx = att_idx_value | int if att_idx_value is not none else loop.index %}
                                        {% if sc is none %}
                                            <span class="t3-attempt-chip muted" title="Attempt {{ att_idx }}: not scored">A{{ att_idx }}: not scored</span>
                                        {% else %}
                                            {% set chip_cls = 'pass' if sc >= t3_pass_threshold else ('warn' if sc >= 0.4 else 'fail') %}
                                            {% set chip_label = 'pass' if sc >= t3_pass_threshold else 'fail' %}
                                            <span class="t3-attempt-chip {{ chip_cls }}">A{{ att_idx }}: {{ "%.2f" | format(sc) }} {{ chip_label }}</span>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                {% else %}
                                <span class="t3-attempt-chip muted">no attempts recorded</span>
                                {% endif %}
                            </td>
                            <td style="font-variant-numeric:tabular-nums;">{{ attempts_used }} of {{ total_expected }} scored</td>
                            <td>
                                {% if best_score is not none %}
                                    {% set bg = 'rgba(34,197,94,0.18)' if best_score >= t3_pass_threshold else ('rgba(234,179,8,0.18)' if best_score >= 0.4 else 'rgba(239,68,68,0.18)') %}
                                    {% set fg = 'var(--success-color)' if best_score >= t3_pass_threshold else ('var(--warning-color)' if best_score >= 0.4 else 'var(--danger-color)') %}
                                    <span style="background:{{ bg }};color:{{ fg }};font-weight:700;padding:0.18rem 0.5rem;border-radius:4px;font-variant-numeric:tabular-nums;">{{ "%.2f" | format(best_score) }}</span>
                                {% else %}
                                    <span style="color:var(--text-secondary);">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if passed and first_pass_attempt is not none %}
                                    <span class="t3-pill ok">passed on scored attempt {{ first_pass_attempt | int }}</span>
                                {% elif passed %}
                                    <span class="t3-pill ok">passed</span>
                                {% elif attempts_used > 0 %}
                                    <span class="t3-pill critical">failed across {{ attempts_used }} scored attempt{{ 's' if attempts_used != 1 else '' }}</span>
                                {% else %}
                                    <span class="t3-pill warning">not scored</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
                </div>
            </details>
            {% endif %}

            {# ----- Detailed per-evaluator drill-down (collapsed; preserves all original info) ----- #}
            <details class="t3-details">
                <summary>Per-Evaluator Drill-Down</summary>
                <div class="t3-details-body">
                <div class="t3-filter-bar">
                    <input class="t3-filter-input" type="search" placeholder="Filter by agent, case, score..." oninput="tier3FilterTable(this, 't3-trials-table')" aria-label="Filter trials">
                    <span class="t3-filter-count" data-tier3-filter-count="t3-trials-table">{{ tier3.trials | length }} / {{ tier3.trials | length }}</span>
                </div>
                <div class="table-scroll">
                <table class="summary-table" id="t3-trials-table">
                    <thead><tr>
                        <th>Agent</th><th>Entry</th><th>Overall</th>
                        {% for eval_id in t3_eval_ids %}<th>{{ eval_id | replace("_", " ") | title }}</th>{% endfor %}
                        <th>Steps</th><th>Tokens</th><th>Warnings</th>
                    </tr></thead>
                    <tbody>
                    {% for trial in tier3.trials %}
                        {% set scores = trial.scores or {} %}
                        {% set tokens = trial.tokens or {} %}
                        <tr>
                            <td><strong>{{ trial.agent or '(default)' }}</strong></td>
                            <td style="font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:0.82rem;">{{ trial.entry_id or trial.trial_id or '?' }}</td>
                            <td style="background:{{ 'rgba(34,197,94,0.14)' if (trial.overall or 0) >= 0.7 else ('rgba(234,179,8,0.14)' if (trial.overall or 0) >= 0.4 else 'rgba(239,68,68,0.14)') }}; color:{{ 'var(--success-color)' if (trial.overall or 0) >= 0.7 else ('var(--warning-color)' if (trial.overall or 0) >= 0.4 else 'var(--danger-color)') }};font-weight:700;">
                                {{ "%.2f" | format(trial.overall) if trial.overall is not none else "—" }}
                            </td>
                            {% for eval_id in t3_eval_ids %}
                                {% set s = scores.get(eval_id) %}
                                <td style="{% if s is not none %}background:{{ 'rgba(34,197,94,0.14)' if s >= 0.7 else ('rgba(234,179,8,0.14)' if s >= 0.4 else 'rgba(239,68,68,0.14)') }}; color:{{ 'var(--success-color)' if s >= 0.7 else ('var(--warning-color)' if s >= 0.4 else 'var(--danger-color)') }}; font-weight:600;{% endif %}">{{ "%.2f" | format(s) if s is not none else "—" }}</td>
                            {% endfor %}
                            <td>{{ trial.steps or 0 }}</td>
                            <td>{{ ((tokens.prompt or 0) + (tokens.completion or 0)) }}</td>
                            <td>{% if trial.warnings %}<span class="t3-pill warning">{{ trial.warnings | length }}</span>{% else %}—{% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
                </div>
            </details>
            {% else %}
            <p style="color:var(--text-secondary);">No per-trial data available for this run.</p>
            {% endif %}

            {% set t3_lift_trials = (tier3.trials or []) | selectattr('lift_scores', 'defined') | list %}
            {% if t3_lift_trials %}
            <details class="t3-details" id="tier3-lift-per-case" open>
                <summary>Lift per Eval Case</summary>
                <div class="t3-details-body">
                <p style="color:var(--text-secondary);font-size:0.85rem;margin:0 0 0.75rem;">
                    Per-trial with-skill versus baseline. Each bar shows the baseline portion (gray) and the with-skill portion (color); the chip on the right is the delta.
                </p>
                {# Group lift trials by agent for readability; track ordered agent list #}
                {% set t3_lift_grouped = {} %}
                {% set t3_lift_agent_order = [] %}
                {% for trial in t3_lift_trials %}
                    {% set agent_name = trial.agent or '(default)' %}
                    {% if agent_name not in t3_lift_grouped %}
                        {% set _ = t3_lift_grouped.update({agent_name: []}) %}
                        {% set _ = t3_lift_agent_order.append(agent_name) %}
                    {% endif %}
                    {% set _ = t3_lift_grouped[agent_name].append(trial) %}
                {% endfor %}
                {% for agent_name in t3_lift_agent_order %}
                    {% set agent_trials = t3_lift_grouped[agent_name] %}
                    <div class="t3-lift-agent-block">
                        <h4>{{ agent_name }} <span style="color:var(--text-secondary);font-weight:600;font-size:0.78rem;">({{ agent_trials | length }} trial{{ 's' if agent_trials|length != 1 else '' }})</span></h4>
                        {% for trial in agent_trials %}
                            <div class="t3-lift-case-block">
                                <div class="t3-lift-case-id">{{ trial.entry_id or trial.trial_id or '?' }}</div>
                                <div class="t3-lift-grid">
                                    {% for eval_id in t3_eval_ids %}
                                        {% set score = (trial.scores or {}).get(eval_id) %}
                                        {% set base = (trial.baseline_scores or {}).get(eval_id) %}
                                        {% set lift = (trial.lift_scores or {}).get(eval_id) %}
                                        {% if lift is not none and score is not none and base is not none %}
                                            {% set lift_class = 'up' if lift >= tier3_lift_pass_threshold else ('down' if lift <= tier3_lift_fail_threshold else 'flat') %}
                                            {% set base_pct = (base * 100) | round(1) %}
                                            {% set with_pct = (score * 100) | round(1) %}
                                            <div class="t3-lift-row">
                                                <span class="t3-lift-label">{{ eval_id | replace("_", " ") | title }}</span>
                                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                                    <div class="t3-lift-bar" style="flex:1;">
                                                        <div class="t3-lift-base" style="width:{{ base_pct }}%;"></div>
                                                        <div class="t3-lift-with {{ lift_class }}" style="width:{{ with_pct }}%;opacity:0.85;"></div>
                                                        <div class="t3-lift-text"><span style="color:var(--text-secondary);font-weight:600;">{{ "%.2f" | format(base) }}</span>&rarr;<span>{{ "%.2f" | format(score) }}</span></div>
                                                    </div>
                                                    <span class="t3-delta {{ lift_class }}" style="min-width:3.6rem;text-align:center;">{{ "%+.2f" | format(lift) }}</span>
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
                </div>
            </details>
            {% endif %}

            {% set t3_recovery_trials = (tier3.trials or []) | selectattr('error_recovery', 'defined') | list %}
            {% if t3_recovery_trials %}
            <details class="t3-details" id="tier3-error-recovery" open>
                <summary>Error Recovery</summary>
                <div class="t3-details-body">
                <p style="color:var(--text-secondary);font-size:0.85rem;">Trials with failures, warnings, or retry/fault evidence.</p>
                <div class="table-scroll">
                    <table class="summary-table">
                        <thead><tr><th>Agent</th><th>Case</th><th>First Attempt</th><th>Faults</th><th>Details</th></tr></thead>
                        <tbody>
                        {% for trial in t3_recovery_trials %}
                            {% set recovery = trial.error_recovery or {} %}
                            <tr>
                                <td><strong>{{ trial.agent or '(default)' }}</strong></td>
                                <td>{{ trial.entry_id or trial.trial_id or '?' }}</td>
                                <td><span class="t3-pill {{ 'critical' if recovery.first_attempt == 'retries needed' else 'neutral' }}">{{ recovery.first_attempt or 'review' }}</span></td>
                                <td>
                                    {% if recovery.skill_faults %}<span class="t3-pill critical">{{ recovery.skill_faults }} skill</span>{% endif %}
                                    {% if recovery.agent_faults %}<span class="t3-pill warning">{{ recovery.agent_faults }} agent</span>{% endif %}
                                    {% if not recovery.skill_faults and not recovery.agent_faults %}<span style="color:var(--text-secondary);">unclassified</span>{% endif %}
                                </td>
                                <td style="font-size:0.85rem;color:var(--text-secondary);">{{ (recovery.details or trial.warnings or []) | join('; ') }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                </div>
            </details>
            {% endif %}

            {% set t3_warning_trials = (tier3.trials or []) | selectattr('warnings', 'defined') | selectattr('warnings') | list %}
            {% if t3_warning_trials %}
            <details class="t3-details">
                <summary>Trial Warnings</summary>
                <div class="t3-details-body">
                <table class="summary-table" style="width:100%;">
                    <thead><tr><th>Agent</th><th>Entry</th><th>Warnings</th></tr></thead>
                    <tbody>
                    {% for trial in t3_warning_trials %}
                        <tr>
                            <td>{{ trial.agent or '(default)' }}</td>
                            <td>{{ trial.entry_id or trial.trial_id }}</td>
                            <td>{{ trial.warnings | join('; ') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
            </details>
            {% endif %}
        </section>

        {# ---------- Agent Details ---------- #}
        <section class="t3-page" id="tier3-page-agents">
            {% if t3_agents %}
            {% set t3_palette = ["#76b900","#8b5cf6","#ec4899","#06b6d4","#3b82f6","#f59e0b","#22c55e"] %}
            <nav class="t3-agent-tabs" role="tablist" aria-label="Agent details">
                {% for name, agent in t3_agents.items() %}
                {% set agent_idx = loop.index0 %}
                {% set agent_color = t3_palette[agent_idx % (t3_palette | length)] %}
                {% set agent_score = agent.with_skill %}
                <button class="t3-agent-tab-btn{% if loop.first %} active{% endif %}"
                        role="tab"
                        data-tier3-agent="{{ name }}"
                        style="--accent: {{ agent_color }};"
                        onclick="showTier3Agent('{{ name }}', this)">
                    <span class="t3-tab-dot"></span>{{ name }}
                    <span class="t3-tab-score">{{ "%.2f" | format(agent_score) if agent_score is not none else "N/A" }}{% if agent.lift is not none %} ({{ "%+.2f" | format(agent.lift) }}){% endif %}</span>
                </button>
                {% endfor %}
            </nav>

            {% for name, agent in t3_agents.items() %}
            {% set agent_idx = loop.index0 %}
            {% set agent_color = t3_palette[agent_idx % (t3_palette | length)] %}
            {% set agent_score = agent.with_skill %}
            {% set agent_score_color = 'var(--text-secondary)' if agent_score is none else ('var(--success-color)' if agent_score >= 0.7 else ('var(--warning-color)' if agent_score >= 0.4 else 'var(--danger-color)')) %}
            {% set best_dim = none %}
            {% set worst_dim = none %}
            {% for d in agent.dimensions or [] %}
                {% set dscore = d.score if d.score is not none else d.with_skill %}
                {% if best_dim is none or dscore > (best_dim.score if best_dim.score is not none else best_dim.with_skill) %}{% set best_dim = d %}{% endif %}
                {% if worst_dim is none or dscore < (worst_dim.score if worst_dim.score is not none else worst_dim.with_skill) %}{% set worst_dim = d %}{% endif %}
            {% endfor %}
            <div class="t3-agent-panel{% if loop.first %} active{% endif %}" id="tier3-agent-{{ name }}" data-tier3-agent="{{ name }}" role="tabpanel">
                {# Stable, index-based scroll target for jumpToTier3Agent. Raw agent
                   names can contain characters that are unsafe in CSS/HTML IDs (slashes,
                   dots), so deep-links from Overview point at this anchor instead of
                   the panel id. The data-tier3-agent-name attribute lets the JS look
                   up the matching tab button to switch panels in one call. #}
                <a id="{{ t3_agent_anchor_ids[name] }}"
                   class="t3-agent-anchor"
                   data-tier3-agent-name="{{ name }}"
                   tabindex="-1"
                   aria-hidden="true"></a>

                {# KPI strip #}
                <div class="t3-kpi-strip">
                    <div class="t3-kpi-card" style="border-top:3px solid {{ agent_color }};">
                        <div class="t3-kpi-label">Overall Score</div>
                        <div class="t3-kpi-value" style="color:{{ agent_score_color }};">{{ "%.2f" | format(agent_score) if agent_score is not none else "N/A" }}</div>
                        <div class="t3-kpi-sub">baseline {{ "%.2f" | format(agent.baseline) if agent.baseline is not none else "N/A" }}</div>
                    </div>
                    <div class="t3-kpi-card">
                        <div class="t3-kpi-label">Skill Lift</div>
                        {% if agent.lift is not none %}
                        {% set lift_color = 'var(--success-color)' if agent.lift >= tier3_lift_pass_threshold else ('var(--danger-color)' if agent.lift <= tier3_lift_fail_threshold else 'var(--text-secondary)') %}
                        <div class="t3-kpi-value" style="color:{{ lift_color }};">{{ "%+.2f" | format(agent.lift) }}</div>
                        <div class="t3-kpi-sub">{% if agent.lift >= tier3_lift_pass_threshold %}positive{% elif agent.lift <= tier3_lift_fail_threshold %}regression{% else %}neutral{% endif %}</div>
                        {% else %}
                        <div class="t3-kpi-value" style="color:var(--text-secondary);">N/A</div>
                        <div class="t3-kpi-sub">{% if agent.with_skill is none and agent.baseline is not none %}with-skill unavailable{% elif agent.with_skill is none %}N/A lift{% else %}no baseline{% endif %}</div>
                        {% endif %}
                    </div>
                    <div class="t3-kpi-card">
                        <div class="t3-kpi-label">Trials</div>
                        <div class="t3-kpi-value">{{ agent.num_trials or 0 }}</div>
                        <div class="t3-kpi-sub">{% if agent.num_trials_baseline %}{{ agent.num_trials_baseline }} baseline{% else %}with-skill only{% endif %}</div>
                    </div>
                    {% if best_dim %}
                    {% set best_score = best_dim.score if best_dim.score is not none else best_dim.with_skill %}
                    <div class="t3-kpi-card">
                        <div class="t3-kpi-label">Best Dimension</div>
                        <div class="t3-kpi-value" style="font-size:1.1rem; color:var(--success-color);">{{ best_dim.id | title }}</div>
                        <div class="t3-kpi-sub">{{ "%.2f" | format(best_score or 0.0) }}</div>
                    </div>
                    {% endif %}
                    {% if worst_dim and worst_dim.id != (best_dim.id if best_dim else None) %}
                    {% set worst_score = worst_dim.score if worst_dim.score is not none else worst_dim.with_skill %}
                    <div class="t3-kpi-card">
                        <div class="t3-kpi-label">Weakest Dimension</div>
                        <div class="t3-kpi-value" style="font-size:1.1rem; color:var(--danger-color);">{{ worst_dim.id | title }}</div>
                        <div class="t3-kpi-sub">{{ "%.2f" | format(worst_score or 0.0) }}</div>
                    </div>
                    {% endif %}
                </div>

                {# SkillEvaluator Dimension Mapping pill strip #}
                {% if agent.dimensions or agent.findings %}
                <div class="t3-dim-strip" aria-label="SkillEvaluator dimensions">
                    {% set dim_source = agent.dimensions or agent.findings %}
                    {% for d in dim_source %}
                        {% set d_score = d.score if d.score is not none else d.with_skill %}
                        {% set d_id = d.id or d.dimension or d.label %}
                        {% set d_color = 'var(--text-secondary)' if d_score is none else ('var(--success-color)' if d_score >= 0.7 else ('var(--warning-color)' if d_score >= 0.4 else 'var(--danger-color)')) %}
                        <div class="t3-dim-pill" title="{{ t3_dim_hints.get(d_id) or d.explanation or '' }}">
                            <span class="t3-dim-name">{{ d_id | replace("_", " ") }}</span>
                            <span class="t3-dim-score" style="color:{{ d_color }};">{{ "%.2f" | format(d_score) if d_score is not none else "N/A" }}</span>
                            {% if d.lift is not none %}
                                {% set lift_class = 'up' if d.lift >= tier3_lift_pass_threshold else ('down' if d.lift <= tier3_lift_fail_threshold else 'flat') %}
                                <span class="t3-delta {{ lift_class }}">{{ "%+.2f" | format(d.lift) }} lift</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                {% endif %}

                {# Vertically stacked evaluator cards #}
                {% if agent.evaluator_cards %}
                <div class="t3-eval-stack">
                {% for card in agent.evaluator_cards %}
                    {% set card_score = card.with_skill or 0.0 %}
                    {% set card_color = 'var(--success-color)' if card_score >= 0.7 else ('var(--warning-color)' if card_score >= 0.4 else 'var(--danger-color)') %}
                    {% set arc_offset = (1 - (card_score | float)) * 175.93 %}
                    {% set baseline_pct = ((card.baseline or 0) * 100) | round(1) %}
                    {% set with_pct = (card_score * 100) | round(1) %}
                    <div class="t3-eval-card {{ card.status or 'warning' }}">
                        <div class="t3-eval-head">
                            <div>
                                <div class="t3-eval-title">{{ card.label }}</div>
                                {% if card.description %}<span class="t3-eval-desc">{{ card.description }}</span>{% endif %}
                            </div>
                            <div class="t3-eval-gauge" aria-label="Score {{ "%.2f" | format(card_score) }}">
                                <svg viewBox="0 0 64 64">
                                    <circle class="t3-gauge-track" cx="32" cy="32" r="28"/>
                                    <circle class="t3-gauge-arc" cx="32" cy="32" r="28"
                                            stroke="{{ card_color }}"
                                            stroke-dasharray="175.93"
                                            stroke-dashoffset="{{ arc_offset }}"/>
                                </svg>
                                <div class="t3-gauge-text" style="color:{{ card_color }};">{{ "%.2f" | format(card_score) }}</div>
                            </div>
                            <div>
                                <span class="t3-pill {{ card.status or 'warning' }}">{{ card.status or 'review' }}</span>
                                {% if card.lift is not none %}
                                    {% set ev_lift_class = 'up' if card.lift >= tier3_lift_pass_threshold else ('down' if card.lift <= tier3_lift_fail_threshold else 'flat') %}
                                    <div class="t3-delta {{ ev_lift_class }}" style="margin-top:0.4rem; display:inline-block;">{{ "%+.2f" | format(card.lift) }} lift</div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="t3-eval-bars">
                            <span class="t3-bar-label">Baseline</span>
                            <div class="t3-bar-track"><div class="t3-bar-fill" style="width:{{ baseline_pct }}%; background:var(--text-secondary); opacity:0.55;"></div></div>
                            <span class="t3-bar-value" style="color:var(--text-secondary);">{{ "%.2f" | format(card.baseline) if card.baseline is not none else "N/A" }}</span>
                            <span class="t3-bar-label">With skill</span>
                            <div class="t3-bar-track"><div class="t3-bar-fill" style="width:{{ with_pct }}%; background:{{ card_color }};"></div></div>
                            <span class="t3-bar-value" style="color:{{ card_color }};">{{ "%.2f" | format(card_score) }}</span>
                        </div>
                        {% if card.evidence %}
                        {# Deduplicate evidence by entry_id: count + average score, keep notes/failures from first non-empty #}
                        {% set dedup_map = {} %}
                        {% set dedup_order = [] %}
                        {% for ev in card.evidence %}
                            {% set eid = ev.entry_id or 'trial' %}
                            {% if eid not in dedup_map %}
                                {% set _ = dedup_order.append(eid) %}
                                {% set _ = dedup_map.update({eid: {'count': 0, 'sum': 0.0, 'with_score': 0, 'notes': [], 'failures': [], 'checks': [], 'evidence_refs': []}}) %}
                            {% endif %}
                            {% set entry = dedup_map[eid] %}
                            {% set ev_occurrences = ev.occurrences or 1 %}
                            {% set _ = entry.update({'count': entry.count + ev_occurrences}) %}
                            {% if ev.score is not none %}
                                {% set _ = entry.update({'sum': entry.sum + (ev.score * ev_occurrences), 'with_score': entry.with_score + ev_occurrences}) %}
                            {% endif %}
                            {% if ev.notes and not entry.notes %}{% set _ = entry.update({'notes': ev.notes}) %}{% endif %}
                            {% if ev.failures and not entry.failures %}{% set _ = entry.update({'failures': ev.failures}) %}{% endif %}
                            {% if ev.checks and not entry.checks %}{% set _ = entry.update({'checks': ev.checks}) %}{% endif %}
                            {% if ev.evidence_refs and not entry.evidence_refs %}{% set _ = entry.update({'evidence_refs': ev.evidence_refs}) %}{% endif %}
                        {% endfor %}
                        {% set evidence_totals = namespace(trials=0) %}
                        {% for ev in card.evidence %}
                            {% set evidence_totals.trials = evidence_totals.trials + (ev.occurrences or 1) %}
                        {% endfor %}
                        <details class="t3-eval-evidence">
                            {% if card.evidence_sampling and card.evidence_sampling.truncated %}
                            <summary>Per-trial evidence (&gt;={{ card.evidence_sampling.represented_cases }} cases, &gt;={{ card.evidence_sampling.represented_trials }} of {{ card.evidence_sampling.total_trials }} trials; sampled first {{ card.evidence_sampling.scanned_trials }})</summary>
                            {% else %}
                            <summary>Per-trial evidence ({{ dedup_order | length }} cases, {{ evidence_totals.trials }} trials)</summary>
                            {% endif %}
                            <ul>
                            {% for eid in dedup_order %}
                                {% set ev = dedup_map[eid] %}
                                {% set avg_score = (ev.sum / ev.with_score) if ev.with_score else None %}
                                {% set ev_color = 'var(--success-color)' if (avg_score or 0) >= 0.7 else ('var(--warning-color)' if (avg_score or 0) >= 0.4 else 'var(--danger-color)') %}
                                <li>
                                    <span class="t3-ev-id">{{ eid }}</span>
                                    <span class="t3-ev-notes">
                                        {% if ev.notes %}{{ (ev.notes[:2] | join('; '))[:160] }}{% endif %}
                                        {% if ev.failures %}<span style="color:var(--danger-color);">{{ (ev.failures[:2] | join('; '))[:120] }}</span>{% endif %}
                                        {% if not ev.notes and not ev.failures and ev.checks %}{{ (ev.checks | length) }} checks{% endif %}
                                        {% if ev.evidence_refs %}<span class="t3-ev-refs">Evidence: {{ ev.evidence_refs[:3] | join('; ') }}</span>{% endif %}
                                    </span>
                                    <span class="t3-ev-count">×{{ ev.count }}</span>
                                    {% if avg_score is not none %}
                                        <span class="t3-bar-value" style="color:{{ ev_color }};">{{ "%.2f" | format(avg_score) }}</span>
                                    {% else %}
                                        <span class="t3-bar-value" style="color:var(--text-secondary);">N/A</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                            </ul>
                        </details>
                        {% endif %}
                    </div>
                {% endfor %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
            {% else %}
            <p style="color:var(--text-secondary);">No per-agent data available.</p>
            {% endif %}
        </section>

        {# ---------- Dataset ---------- #}
        <section class="t3-page" id="tier3-page-dataset">
            {% if t3_dataset %}
            <div class="t3-dataset-hero">
                <h2>AgentSkills Dataset</h2>
                <p style="color:var(--text-secondary);font-size:0.9rem;margin:0.25rem 0 0;">
                    {{ t3_dataset | length }} AgentSkills eval case{{ 's' if t3_dataset | length != 1 else '' }} used for this Tier 3 run.
                </p>
                <div class="t3-ds-meta" style="margin-top:0.75rem;">
                    <span class="t3-ds-chip">Skill: <b>{{ tier3.skill_name or 'unknown' }}</b></span>
                    <span class="t3-ds-chip">Best Performing Agent: <b>{{ t3_best_name or 'N/A' }}</b></span>
                    {% set t3_env = (tier3.summary.environment if tier3.summary is defined and tier3.summary else None) or tier3.environment %}
                    {% if t3_env %}<span class="t3-ds-chip">Environment: <b>{{ t3_env }}</b></span>{% endif %}
                    <span class="t3-ds-chip">Schema: <b>v{{ tier3.schema_version or '2.0' }}</b></span>
                </div>
            </div>
            <div class="t3-filter-bar">
                <input class="t3-filter-input" type="search" placeholder="Filter eval cases by id, question, skill..." oninput="tier3FilterCards(this, 't3-dataset-list')" aria-label="Filter dataset">
                <span class="t3-filter-count" data-tier3-filter-count="t3-dataset-list">{{ t3_dataset | length }} / {{ t3_dataset | length }}</span>
            </div>
            <div class="t3-dataset-list" id="t3-dataset-list">
                {% for case in t3_dataset %}
                {% set case_prompt = case.prompt or case.question %}
                {% set case_expected_output = case.expected_output or case.ground_truth %}
                {% set case_assertions = case.assertions or case.expected_behavior %}
                {% set _hay = (case.id or '') ~ ' ' ~ (case_prompt or '') ~ ' ' ~ (case.expected_skill or '') ~ ' ' ~ (case.expected_script or '') ~ ' ' ~ (case.category or '') ~ ' ' ~ (case_expected_output or '') %}
                <details class="t3-ds-card" id="dataset-case-{{ case.id or loop.index }}" data-tier3-filterable="{{ _hay }}"{% if loop.first %} open{% endif %}>
                    <summary>
                    <div class="t3-ds-head" style="margin-bottom:0;">
                        <span class="t3-ds-id">{{ case.id or 'case-' ~ loop.index }}</span>
                        <div class="t3-ds-meta">
                            <span class="t3-ds-chip">Skill: <b>{{ case.expected_skill if case.expected_skill else 'none' }}</b></span>
                            <span class="t3-ds-chip">Script: <b>{{ case.expected_script if case.expected_script else 'none' }}</b></span>
                            {% if case.category %}<span class="t3-ds-chip">Category: <b>{{ case.category }}</b></span>{% endif %}
                        </div>
                    </div>
                    </summary>
                    <div class="t3-ds-body">
                    {% if case_prompt %}
                    <div class="t3-ds-field">
                        <span class="t3-ds-label">Prompt</span>
                        <div class="t3-ds-value">{{ case_prompt }}</div>
                    </div>
                    {% endif %}
                    {% if case_expected_output %}
                    <div class="t3-ds-field">
                        <span class="t3-ds-label">Expected Output</span>
                        <div class="t3-ds-value t3-ds-gt">{{ case_expected_output }}</div>
                    </div>
                    {% endif %}
                    {% if case_assertions %}
                    <div class="t3-ds-field">
                        <span class="t3-ds-label">Assertions</span>
                        <ol class="t3-ds-behaviors">{% for b in case_assertions %}<li>{{ b }}</li>{% endfor %}</ol>
                    </div>
                    {% endif %}
                    </div>
                </details>
                {% endfor %}
            </div>
            {% else %}
            <p style="color:var(--text-secondary);">No dataset entries loaded for this run.</p>
            {% endif %}
        </section>

        {# ---------- Insights (Conclusions + Recommendations) ---------- #}
        <section class="t3-page" id="tier3-page-suggestions">
            {% set t3_has_conclusions = tier3.conclusions and (tier3.conclusions | length) > 0 %}
            {% set t3_recommendations = tier3.recommendations or [] %}
            {% set t3_has_suggestions = (t3_recommendations | length) > 0 or (tier3.suggestions and (tier3.suggestions | length) > 0) %}

            <p style="color:var(--text-secondary);font-size:0.85rem;margin:0 0 0.85rem;">
                Insights combine deterministic baselines (best performing agent, weakest dimension, coverage gaps)
                with additional contextual observations and action items produced by an LLM-as-Judge.
                The
                <span class="t3-insight-source insight-source-deterministic">deterministic</span>
                tag marks the stable baselines; the
                <span class="t3-insight-source insight-source-llm">LLM</span>
                tag marks judge-generated entries that may vary between runs.
                {% if t3_evidence_links %}Evidence links open the matching Harbor trial or exact trajectory step when captured.{% endif %}
            </p>

            {% if t3_has_conclusions %}
            <details class="t3-details" id="tier3-conclusions" open>
                <summary>Conclusions</summary>
                <div class="t3-details-body">
                    <div class="t3-sug-stack">
                    {% for conclusion in tier3.conclusions %}
                        {% set sev = conclusion.severity or 'warn' %}
                        {% set sev_class = 'severity-pass' if sev in ('pass','ok') else ('severity-fail' if sev in ('fail','critical','high') else 'severity-warn') %}
                        {% set sev_pill = 'ok' if sev in ('pass','ok') else ('critical' if sev in ('fail','critical','high') else 'warning') %}
                        {% set source = (conclusion.source or 'deterministic') %}
                        <div class="t3-sug-card {{ sev_class }}">
                            <span class="t3-sug-num">{{ loop.index }}</span>
                            <div>
                                <div class="t3-sug-title">
                                    {{ conclusion.title }}
                                    <span class="t3-pill {{ sev_pill }}">{{ sev }}</span>
                                    <span class="t3-insight-source insight-source-{{ source }}">{{ source }}</span>
                                </div>
                                <div class="t3-sug-body">{{ conclusion.message }}</div>
                                {% if conclusion.evidence and conclusion.evidence.url %}
                                <a class="t3-evidence-link" href="{{ conclusion.evidence.url }}" target="_blank" rel="noopener">View {{ conclusion.evidence.label or 'evidence' }}</a>
                                {% endif %}
                            </div>
                            <div class="t3-sug-actions">
                                <button class="t3-copy-btn" onclick='tier3CopyText(this, {{ ((conclusion.title ~ ': ' ~ conclusion.message) | tojson) }})'>Copy</button>
                            </div>
                        </div>
                    {% endfor %}
                    </div>
                </div>
            </details>
            {% endif %}

            {% if t3_has_suggestions %}
            <details class="t3-details" open>
                <summary>Recommendations</summary>
                <div class="t3-details-body">
                    <div class="t3-sug-stack">
                    {% if t3_recommendations %}
                        {% for reco in t3_recommendations %}
                            {% set sev = reco.severity or 'warn' %}
                            {% set sev_class = 'severity-pass' if sev in ('pass','ok') else ('severity-fail' if sev in ('fail','critical','high') else 'severity-warn') %}
                            {% set source = (reco.source or 'deterministic') %}
                            <div class="t3-sug-card {{ sev_class }}">
                                <span class="t3-sug-num">{{ loop.index }}</span>
                                <div>
                                    <div class="t3-sug-title">
                                        <span class="t3-sug-cat">{{ reco.category or 'Action' }}</span>
                                        {% if reco.title %}<span style="font-weight:700;">{{ reco.title }}</span>{% endif %}
                                        <span class="t3-insight-source insight-source-{{ source }}">{{ source }}</span>
                                    </div>
                                    <div class="t3-sug-body">{{ reco.message }}</div>
                                    {% if reco.evidence and reco.evidence.url %}
                                    <a class="t3-evidence-link" href="{{ reco.evidence.url }}" target="_blank" rel="noopener">View {{ reco.evidence.label or 'evidence' }}</a>
                                    {% endif %}
                                </div>
                                <div class="t3-sug-actions">
                                    <button class="t3-copy-btn" onclick='tier3CopyText(this, {{ (reco.message | string | tojson) }})'>Copy</button>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        {% for suggestion in tier3.suggestions %}
                            {% set fallback_evidence = none %}
                            {% if t3_evidence_links and (t3_evidence_links | length) > 0 %}
                                {% set fallback_evidence = t3_evidence_links[loop.index0 % (t3_evidence_links | length)] %}
                            {% endif %}
                            {% set first_word = (suggestion | string).split(' ')[0] | lower %}
                            {% set cat = 'Update' if first_word in ('update','revise','refactor','rewrite','rework')
                                         else ('Add' if first_word in ('add','create','introduce','provide','include')
                                         else ('Implement' if first_word in ('implement','build','develop','design','enable')
                                         else ('Document' if first_word in ('document','clarify','describe','explain','note')
                                         else ('Fix' if first_word in ('fix','correct','resolve','address','repair')
                                         else ('Test' if first_word in ('test','verify','validate','check','ensure')
                                         else 'Action'))))) %}
                            <div class="t3-sug-card severity-warn">
                                <span class="t3-sug-num">{{ loop.index }}</span>
                                <div>
                                    <div class="t3-sug-title">
                                        <span class="t3-sug-cat">{{ cat }}</span>
                                        <span class="t3-insight-source insight-source-deterministic">deterministic</span>
                                    </div>
                                    <div class="t3-sug-body">{{ suggestion }}</div>
                                    {% if fallback_evidence and fallback_evidence.url %}
                                    <a class="t3-evidence-link" href="{{ fallback_evidence.url }}" target="_blank" rel="noopener">View {{ fallback_evidence.label or 'evidence' }}</a>
                                    {% endif %}
                                </div>
                                <div class="t3-sug-actions">
                                    <button class="t3-copy-btn" onclick='tier3CopyText(this, {{ (suggestion | string | tojson) }})'>Copy</button>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                    </div>
                </div>
            </details>
            {% endif %}

            {% if not t3_has_conclusions and not t3_has_suggestions %}
            <p style="color:var(--text-secondary);">No evaluation insights were generated.</p>
            {% endif %}
        </section>

        {# ---------- Diagnostics (raw SkillEvaluator data + downloads) ---------- #}
        <section class="t3-page" id="tier3-page-provenance">
            <p style="color:var(--text-secondary);">
                Diagnostics preserve raw evaluation artifacts for deep dives and troubleshooting.
                The main report leads with human-readable dimensions; the blocks below show the
                underlying evaluator scores, Harbor artifacts, and timing &mdash; each available as a
                one-click download.
            </p>

            {# Attempt Policy is configuration/provenance: useful for reproducing a run but not
               an Overview decision signal. Keep it here so reviewers can confirm the exact
               max-attempts / pass-threshold / stop-on-pass settings the run used. #}
            {% if tier3.attempt_policy and (t3_max_attempts > 1 or t3_attempt_policy.stop_on_pass) %}
            <div class="t3-section t3-collapsed" id="tier3-attempt-policy">
                <strong>Attempt Policy:</strong> max attempts {{ t3_max_attempts }},
                pass threshold &ge; {{ "%.2f" | format(t3_attempt_policy.pass_threshold or 0.5) }},
                stop-on-pass {{ 'enabled' if t3_attempt_policy.stop_on_pass else 'disabled' }}.
            </div>
            {% endif %}

            <details class="t3-details" open>
                <summary>JSON Downloads</summary>
                <div class="t3-details-body">
                    <p style="color:var(--text-secondary);font-size:0.85rem;margin:0 0 0.75rem;">
                        Use these to share or attach the underlying data to a bug report.
                    </p>
                    <div class="t3-download-grid">
                        <button class="t3-copy-btn" onclick="tier3DownloadJson('tier3-full', 'tier3-full.json')">Download Full Tier 3 Payload</button>
                        {% if t3_provenance.raw_evaluators %}
                        <button class="t3-copy-btn" onclick="tier3DownloadJson('tier3-raw-evaluators', 'tier3-raw-evaluators.json')">Download Raw Evaluators</button>
                        {% endif %}
                        {% if t3_provenance.raw_lift %}
                        <button class="t3-copy-btn" onclick="tier3DownloadJson('tier3-raw-lift', 'tier3-raw-lift.json')">Download Raw Lift</button>
                        {% endif %}
                        {% if t3_provenance.comparison %}
                        <button class="t3-copy-btn" onclick="tier3DownloadJson('tier3-comparison', 'tier3-comparison.json')">Download comparison.json</button>
                        {% endif %}
                        {% if tier3.timing %}
                        <button class="t3-copy-btn" onclick="tier3DownloadJson('tier3-timing', 'tier3-timing.json')">Download Pipeline Timing</button>
                        {% endif %}
                    </div>
                </div>
            </details>
            <script type="application/json" id="tier3-full"{% if tier3_canonical_encoding == 'base64' %} data-encoding="base64"{% endif %}>{{ tier3_canonical_data | safe }}</script>

            {% if tier3.evaluators %}
            <details class="t3-details">
                <summary>Raw Evaluator Scores (best performing agent: {{ t3_best_name or 'N/A' }})</summary>
                <div class="t3-details-body">
                <table class="summary-table" style="width:100%;">
                    <thead><tr><th>Evaluator</th><th>With Skill</th><th>Baseline</th><th>Lift</th></tr></thead>
                    <tbody>
                    {% for name, scores in tier3.evaluators.items() %}
                    <tr>
                        <td><strong>{{ name | replace("_", " ") | title }}</strong></td>
                        <td>{{ "%.2f" | format(scores.with_skill) if scores.with_skill is not none else "N/A" }}</td>
                        <td>{{ "%.2f" | format(scores.baseline) if scores.baseline is not none else "N/A" }}</td>
                        <td style="color:{{ 'var(--success-color)' if scores.lift is not none and scores.lift >= tier3_lift_pass_threshold else ('var(--danger-color)' if scores.lift is not none and scores.lift <= tier3_lift_fail_threshold else 'var(--text-secondary)') }};font-weight:600;">
                            {{ "%+.2f" | format(scores.lift) if scores.lift is not none else "N/A" }}
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
            </details>
            {% endif %}

            {% if t3_provenance.evaluator_paths or t3_provenance.run_dir or t3_harbor_job_url or t3_harbor_analysis_url %}
            <details class="t3-details" open>
                <summary>Artifact Paths</summary>
                <div class="t3-details-body">
                    <div class="t3-prov-grid">
                        {% if t3_harbor_job_url %}
