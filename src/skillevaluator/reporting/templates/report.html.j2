            .t3-link-btn { background:var(--secondary-color); border:1px solid var(--secondary-color); color:white; border-radius:7px; padding:0.38rem 0.75rem; font-size:0.78rem; font-weight:800; cursor:pointer; }
            .t3-link-btn:hover { filter:brightness(0.95); }
            .t3-agent-link { background:transparent; border:0; color:var(--secondary-color); font:inherit; font-weight:800; padding:0; cursor:pointer; text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:2px; }
            .t3-agent-link:hover { color:var(--accent-color); }
            .t3-agent-deeplink { cursor:pointer; transition:transform 0.15s ease, border-color 0.15s ease; }
