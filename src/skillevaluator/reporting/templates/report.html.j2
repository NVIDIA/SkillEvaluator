            .t3-harbor-panel { background:var(--bg); border:1px solid var(--border-color); border-left:4px solid var(--secondary-color); border-radius:12px; padding:0.95rem 1.1rem; box-shadow:var(--shadow); margin:0 0 1rem; display:flex; gap:1rem; justify-content:space-between; align-items:center; flex-wrap:wrap; }
            .t3-harbor-panel strong { color:var(--dark-text); }
            .t3-harbor-panel p { color:var(--text-secondary); margin:0.2rem 0 0; font-size:0.85rem; line-height:1.45; }
            .t3-harbor-actions { display:flex; gap:0.45rem; flex-wrap:wrap; }
            .t3-harbor-link, .t3-evidence-link { display:inline-flex; align-items:center; gap:0.3rem; border:1px solid var(--border-color); border-radius:7px; background:var(--bg-secondary); color:var(--secondary-color); text-decoration:none; font-weight:800; }
            .t3-harbor-link { padding:0.42rem 0.75rem; font-size:0.8rem; }
            .t3-evidence-link { padding:0.22rem 0.55rem; font-size:0.76rem; margin-top:0.45rem; }
            .t3-harbor-link:hover, .t3-evidence-link:hover { border-color:var(--secondary-color); background:var(--bg); color:var(--accent-color); }
            .t3-next-steps { background:var(--bg); border:1px solid var(--border-color); border-radius:12px; padding:1rem 1.15rem; box-shadow:var(--shadow); margin:0 0 1rem; }
