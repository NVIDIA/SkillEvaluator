.container{max-width:1320px;margin:0 auto;padding:30px 40px 64px;min-width:0}.report-breadcrumb{font-size:11px;color:var(--text-secondary);margin-bottom:20px}.agent-hero{background:var(--bg);border:1px solid var(--border-color);border-radius:10px;padding:26px 28px;margin-bottom:16px;box-shadow:none}.agent-hero-eyebrow{font-size:10px;letter-spacing:1.4px;color:var(--text-secondary);text-transform:uppercase}.agent-hero-title{font-size:28px;line-height:1.22;font-weight:650;margin-top:8px;overflow-wrap:anywhere}.agent-hero-top{gap:24px}.agent-hero-subtitle{font-size:12px;overflow-wrap:anywhere;max-width:650px;margin-top:12px}.agent-hero-score{font-size:35px}.agent-hero-score.verdict-text{font-size:23px;font-weight:650;max-width:250px;line-height:1.15}.verdict-caption{font-size:10px;color:var(--text-secondary);text-align:right;margin:7px 0 12px;text-transform:uppercase;letter-spacing:1px}.agent-hero-detail{font-size:11px;line-height:1.8}.score-pass{color:var(--success-color)}.score-fail{color:var(--danger-color)}.score-warn{color:var(--warning-color)}
.tier-cards{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px;padding-top:20px;border-top:1px solid var(--border-color)}.tier-card{flex:1;min-width:180px;border:1px solid var(--border-color);border-radius:6px;padding:12px 14px;background:var(--bg);box-shadow:none;border-left:1px solid var(--border-color);cursor:pointer}.tier-card.active{border-color:#7c9c52;box-shadow:inset 0 0 0 1px #7c9c52;background:var(--bg-secondary)}.tier-card:hover{transform:none;box-shadow:none}.tier-card-label{font-size:10px;color:var(--text-secondary)}.tier-card-title{font-size:12px;font-weight:600;color:var(--dark-text);margin:6px 0}.tier-card-stats{font-size:10px;line-height:1.6}.tier-card-verdict{font-size:9px}.tier-card-sev-pill{font-size:9px}.scope-strip{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:11px;color:var(--text-secondary);padding:0 2px 16px}.scope-strip span+span{border-left:1px solid var(--border-color);padding-left:18px}
