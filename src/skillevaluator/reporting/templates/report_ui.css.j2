.quality-outcome-note{font-size:11px;color:var(--text-secondary);margin-bottom:12px}.export-btn{text-decoration:none}

.incomplete-notice,.scan-diagnostic{font-size:12px;line-height:1.6;margin:0 0 10px;padding:10px 12px;background:var(--badge-warn-bg);color:var(--badge-warn-tx);border-radius:5px;overflow-wrap:anywhere}
.agent-hero-title-block,.agent-hero-top>div,.skill-checks-summary,.check-result,.check-header>div,.report-searchbar>*{min-width:0}.quality-score-block{max-width:100%;overflow-x:auto}.check-header{flex-wrap:wrap;gap:8px}.check-details{min-width:0}.check-name,.check-description,.finding-msg,.finding-meta{overflow-wrap:anywhere}
