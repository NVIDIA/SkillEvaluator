/* Severity tags: one token pair per level. The [data-theme] selectors outrank the base template's hard-coded dark colors. */
.severity-critical,[data-theme="dark"] .severity-critical{background:var(--sev-critical-bg);color:var(--sev-critical-tx)}.severity-high,[data-theme="dark"] .severity-high{background:var(--sev-high-bg);color:var(--sev-high-tx)}.severity-medium,[data-theme="dark"] .severity-medium{background:var(--sev-medium-bg);color:var(--sev-medium-tx)}.severity-low,[data-theme="dark"] .severity-low{background:var(--sev-low-bg);color:var(--sev-low-tx)}.severity-info,[data-theme="dark"] .severity-info{background:var(--sev-info-bg);color:var(--sev-info-tx)}
.severity-tag,.status-badge,.metadata-tag,.count-badge,.skill-pill,.quality-pill,.tier-card-verdict,.tier-card-sev-pill{white-space:nowrap}
/* Confidence badges: the type floor, and the palette's AA pairs in both themes. */
.confidence-badge{font-size:11px}.confidence-badge.high-conf,[data-theme="dark"] .confidence-badge.high-conf{background:var(--badge-fail-bg);color:var(--badge-fail-tx)}.confidence-badge.medium-conf,[data-theme="dark"] .confidence-badge.medium-conf{background:var(--badge-warn-bg);color:var(--badge-warn-tx)}.confidence-badge.low-conf,[data-theme="dark"] .confidence-badge.low-conf{background:var(--sev-low-bg);color:var(--sev-low-tx);border-color:var(--border-color)}
.count-badge.medium-count{background:var(--warning-color);color:var(--on-warning)}.count-badge.low-count{background:var(--low-color);color:var(--on-accent)}

/* Header, hero, executive summary and Fix first. */
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.se-logo{flex:none;display:block}
/* The sidebar is dark in both themes, so its logo always uses the dark panel colors. */
.report-sidebar .se-logo{--se-logo-panel:#152117;--se-logo-panel-edge:#304631;--se-logo-ring-outer:#39523a;--se-logo-ring-middle:#6f9264;--se-logo-ring-inner:#dbe8d6;--se-logo-core-edge:#9bdb34}
/* One logo per view: the sidebar on wide screens, the header on narrow screens and in print. */
.header-brand{display:flex;align-items:center;gap:10px;min-width:0}.header-brand .se-logo,.header-brand .header-title{display:none}.header-brand .header-title{margin:0;font-size:15px;font-weight:650;line-height:1.2;letter-spacing:-.3px}.header-brand .header-subtitle{margin:0;font-size:12px;color:var(--text-secondary);opacity:1}
.header-content{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 auto}.header-meta{align-items:center}.theme-toggle[aria-pressed="true"]{background:var(--bg-tertiary);border-color:var(--text-secondary)}
.verdict-badge{display:inline-flex;align-items:center;gap:7px;font-size:13px!important;font-weight:650;padding:6px 11px!important;border-radius:999px;white-space:nowrap}.verdict-dot{width:8px;height:8px;border-radius:50%;background:currentColor}
.verdict-chip{display:inline-block;font-size:15px;font-weight:700;padding:5px 12px;border-radius:999px;border:1px solid currentColor;white-space:nowrap}.verdict-chip.pass{background:var(--badge-pass-bg);color:var(--badge-pass-tx)}.verdict-chip.fail{background:var(--badge-fail-bg);color:var(--badge-fail-tx)}.verdict-chip.warn{background:var(--badge-warn-bg);color:var(--badge-warn-tx)}
.verdict-badge,.verdict-chip,.tier-card-verdict,.severity-tag,.status-badge,.sev-dot{print-color-adjust:exact;-webkit-print-color-adjust:exact}
.report-breadcrumb a{color:var(--text-secondary)}.agent-hero-title{color:var(--dark-text)!important}.hero-skills{margin:10px 0 0;font-size:12px;color:var(--text-secondary)}
.agent-hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:24px}.hero-side{display:flex;flex-direction:column;align-items:flex-end;gap:8px;text-align:right;max-width:380px;min-width:0}.hero-side .agent-hero-score,.hero-side .agent-hero-detail{text-align:right}
.hero-score-label{display:block;font-size:12px;font-weight:500;color:var(--text-secondary);margin-top:4px}.hero-reason{margin:0;font-size:12px;color:var(--text-secondary);max-width:340px}
.publication-line{margin:0;font-size:12px;color:var(--text-secondary);display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:4px 8px}.publication-label{font-weight:600;color:var(--dark-text)}.publication-reasons{flex-basis:100%;line-height:1.5}
.tier-card-title{margin:6px 0}/* One Tier 1 card is a scope line: the executive summary carries its verdict and numbers. */.tier-line{margin-top:16px;padding-top:14px}.tier-line .tier-card,.tier-line .tier-card.active{display:flex;flex-direction:row;flex-wrap:wrap;align-items:baseline;gap:4px 14px;border:0;box-shadow:none;background:none;padding:0;min-width:0;color:var(--text-secondary);opacity:1}.tier-line .tier-card::before{display:none}.tier-line .tier-card:hover{transform:none;box-shadow:none}.tier-line .tier-card-head,.tier-line .tier-card-stats{display:contents}.tier-line .tier-card-title{margin:0;font-size:13px}.tier-card-verdict{font-size:12px!important;font-weight:700;padding:2px 8px;border-radius:999px}
.exec-summary{border:1px solid var(--border-color);border-left:4px solid var(--border-color);border-radius:10px;background:var(--bg);padding:20px 22px;margin:0 0 24px}.exec-summary.fail{border-left-color:var(--danger-color)}.exec-summary.pass{border-left-color:var(--success-color)}.exec-summary.warn{border-left-color:var(--warning-color)}
.exec-verdict{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px}.exec-title{margin:0;font-size:inherit;line-height:1}.exec-reason{margin:0;font-size:14px;color:var(--dark-text);flex:1 1 320px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin:18px 0 8px}.kpi{border:1px solid var(--border-color);border-radius:8px;padding:12px 14px;background:var(--bg-secondary);min-width:0}.kpi dt{font-size:12px;font-weight:600;color:var(--text-secondary)}.kpi dd{margin:4px 0 0;font-size:13px;color:var(--dark-text)}.kpi .kpi-value strong{font-size:24px;font-weight:650;letter-spacing:-.5px;font-variant-numeric:tabular-nums}.kpi .kpi-sub{font-size:12px;color:var(--text-secondary);margin-top:6px}
.sev-item{display:inline-block;white-space:nowrap;margin-right:6px}.sev-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px}.sev-dot.critical{background:var(--critical-color)}.sev-dot.high{background:var(--high-color)}.sev-dot.medium{background:var(--medium-color)}.sev-dot.low{background:var(--low-color)}
.kpi-legend{font-size:12px;color:var(--text-secondary);margin:4px 0 0}
.fix-first{margin-top:16px;border-top:1px solid var(--border-color);padding-top:14px}.fix-first h3{font-size:14px;margin:0 0 8px}.fix-first ol{margin:0;padding-left:22px}.fix-first li{padding:6px 0;font-size:13px;line-height:1.5}.fix-first .severity-tag{margin-right:6px;font-size:11px}
.fix-link{font-weight:600;color:var(--dark-text);text-decoration:underline;text-decoration-color:var(--text-secondary);text-underline-offset:3px;overflow-wrap:anywhere}.fix-link:hover{text-decoration-color:currentColor}.fix-meta{display:block;font-size:12px;color:var(--text-secondary)}.fix-meta code{font-size:12px}.fix-more{font-size:12px;color:var(--text-secondary);margin:8px 0 0}
.severity-incomplete,[data-theme="dark"] .severity-incomplete{background:var(--badge-warn-bg);color:var(--badge-warn-tx)}
.check-id{font-size:11px;color:var(--text-secondary);background:var(--bg-tertiary);padding:1px 5px;border-radius:4px;font-weight:500}.validator-link{color:inherit;font-weight:600}
.check-finding:target,.check-result:target,.finding-flash{outline:3px solid var(--focus-ring);outline-offset:2px}/* Land below the sticky filter bar. */.check-finding,.check-result{scroll-margin-top:14rem}
.quality-pill{min-width:24px;min-height:24px;display:inline-flex;align-items:center;justify-content:center;padding:0 6px}
.raw-output{margin:0 0 10px;font-size:12px}.raw-output>summary{cursor:pointer;color:var(--text-secondary);font-weight:600;padding:4px 0}.raw-output .scan-diagnostic{margin-top:6px}
@media(max-width:1150px){.report-sidebar .sidebar-brand{gap:8px}}
@media(max-width:760px){.report-sidebar .sidebar-brand{display:none}.header-brand .se-logo,.header-brand .header-title{display:block}.sidebar-index-link{order:-1}.header-content{flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:space-between}.header-meta{display:contents}.header-status-badge{margin-left:auto}.header-controls{width:100%;justify-content:flex-end}.agent-hero-top{display:block}.hero-side{align-items:flex-start;text-align:left;max-width:none;margin-top:16px}.hero-side .agent-hero-score,.hero-side .agent-hero-detail{text-align:left}.publication-line{justify-content:flex-start}.kpis{grid-template-columns:1fr 1fr}.exec-summary{padding:16px}.top-issues-table{min-width:0}}
@media(max-width:420px){.export-btn span:first-child{display:none}.theme-toggle #theme-icon{display:none}.kpis{grid-template-columns:1fr}}
@media print{.main-header{display:block!important;position:static;border-bottom:1px solid #ccc;padding:6px 0;background:#fff}.header-content{padding:0;flex-direction:row!important;justify-content:space-between!important;align-items:center!important;flex-wrap:wrap;text-align:left!important}.header-brand .se-logo,.header-brand .header-title,.header-brand .header-subtitle{display:block}.header-status-badge{display:inline-flex!important}.header-meta{justify-content:flex-start}.kpi,.fix-first li{break-inside:avoid}.kpi{background:#fff}.fix-link{color:#111}.tier-card{color:inherit}
/* One results view prints. The check table stays for its files scanned and checks performed counts. */
#results-by-validator>.filter-group,#results-by-validator>.section-header,#results-by-validator>.validator-card,#results-by-validator .toggle-icon{display:none!important}.raw-output:not([open]) .scan-diagnostic{display:none}}

/* Tier 3 pills: the type floor and AA text in both themes. The Tier 3 tab has its own later style block, hence the .tab-content prefix. */
.tab-content .t3-insight-source,.tab-content .t3-sug-cat{font-size:11px}.tab-content .insight-source-llm{color:var(--llm-tx)}
