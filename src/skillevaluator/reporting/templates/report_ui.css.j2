/* Report workspace: static evidence, readable without a network connection. */
:root{--light-bg:#f5f6f7;--bg:#fff;--bg-secondary:#f5f6f7;--bg-tertiary:#e8ebed;--dark-text:#24292f;--text-secondary:#59636e;--border-color:#dfe3e6;--primary-color:#26302b;--secondary-color:#487600;--success-color:#357000;--danger-color:#b4232d;--warning-color:#8a5800;--shadow:none;--shadow-lg:0 4px 16px #1f293708;--badge-pass-bg:#edf5e4;--badge-pass-tx:#356300;--badge-fail-bg:#fff0ef;--badge-fail-tx:#a3232b;--badge-warn-bg:#fff5df;--badge-warn-tx:#805300}
body{font-family:ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:14px;line-height:1.55;padding-left:216px;transition:none}
button,input,summary{font:inherit}button{cursor:pointer}a{color:var(--secondary-color)}button:focus-visible,a:focus-visible,input:focus-visible,summary:focus-visible,[tabindex]:focus-visible{outline:3px solid #668fbb;outline-offset:3px}code,pre{font-family:ui-monospace,SFMono-Regular,Consolas,monospace}code{overflow-wrap:anywhere}h1,h2,h3{letter-spacing:-.025em}table{width:100%}td,th{overflow-wrap:anywhere}pre{max-width:100%;overflow:auto}p{overflow-wrap:anywhere}[hidden]{display:none!important}
.skip-link{position:fixed;left:228px;top:-80px;background:var(--bg);z-index:1000;padding:12px 20px}.skip-link:focus{top:8px}
.report-sidebar{position:fixed;inset:0 auto 0 0;width:216px;background:#1e2328;color:#c7ced5;display:flex;flex-direction:column;padding:29px 16px;z-index:110}.report-sidebar a{color:#c7ced5;text-decoration:none;border-radius:6px;padding:10px 12px;margin-bottom:4px;font-size:13px}.report-sidebar a:hover{background:#2a3036;color:#fff}.report-sidebar .sidebar-brand{display:flex;align-items:center;gap:10px;color:white;padding:0 6px 37px;font-weight:650;font-size:16px;letter-spacing:-.5px}.sidebar-brand small{display:block;font-size:8px;letter-spacing:1.2px;color:#9da7af;margin-top:6px}.brand-mark{border:1px solid #76b900;border-radius:8px;color:#98cd45;width:30px;height:33px;display:grid;place-items:center;font-family:ui-monospace,monospace;font-size:19px;font-weight:500}.sidebar-label{color:#89949e;font-size:9px;letter-spacing:1.5px;margin:0 12px 12px}.report-sidebar .sidebar-current{background:#30392b;color:#c3e498;border-left:2px solid #76b900}.sidebar-footer{margin-top:auto;padding:14px 12px 0;color:#939da6;font-size:11px;line-height:1.8}
