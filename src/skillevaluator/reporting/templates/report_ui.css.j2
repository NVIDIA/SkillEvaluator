.dashboard{display:flex;flex-wrap:wrap;gap:0;margin:18px 0 24px;border:1px solid var(--border-color);background:var(--bg);border-radius:8px;padding:14px 0}.dashboard-card{flex:1;min-width:130px;border:0;border-right:1px solid var(--border-color);border-radius:0;padding:0 18px;box-shadow:none;background:transparent}.dashboard-card:last-child{border-right:0}.dashboard-card:hover{box-shadow:none}.dashboard-card-title{font-size:9px;letter-spacing:.8px}.dashboard-card-value{font-size:21px}.dashboard-card-subtitle{font-size:10px}.dashboard .progress-bar{display:none}.severity-breakdown-label{font-size:9px}
.top-issues-section{border:1px solid #ead6d5;border-radius:8px;box-shadow:none;margin:0 0 18px;background:var(--bg);overflow:hidden}.top-issues-header{background:var(--badge-fail-bg);padding:13px 18px;color:var(--badge-fail-tx);border:0}.top-issues-header h3{font-size:13px;color:inherit;font-weight:650}.top-issues-content.active{max-height:none}.top-issues-table{font-size:11px}.top-issues-table th{background:var(--bg);font-size:9px;letter-spacing:.4px;text-transform:uppercase;color:var(--text-secondary);padding:12px 15px}.top-issues-table td{padding:12px 15px;vertical-align:top}.top-issues-table tbody tr{cursor:pointer}.skills-pills{gap:5px}.skill-pill,.quality-pill{font-size:9px}.count-badge,.metadata-tag,.severity-tag{font-size:9px;box-shadow:none}.contributor-section{margin-top:16px;border:1px solid var(--border-color);box-shadow:none}.contributor-header{background:var(--bg-secondary);padding:12px 16px}.contributor-header h3{font-size:12px}.contributor-content.active{max-height:none}
.report-searchbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:15px}.report-searchbar label{font-size:11px;font-weight:600}.report-searchbar input{min-width:190px;flex:1;padding:10px 12px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg);color:var(--dark-text);font-size:12px}.report-searchbar #report-search-count{font-size:10px;color:var(--text-secondary)}.report-no-matches{padding:24px;border:1px dashed var(--border-color);border-radius:8px;margin-bottom:18px;background:var(--bg);color:var(--text-secondary)}.view-toggle-section{background:none;border:0;padding:0;gap:6px}.view-toggle-btn,.filter-btn,.bulk-action-btn,.severity-filter-btn{font-size:11px;padding:7px 11px;min-height:32px;border-radius:5px;background:var(--bg);color:var(--dark-text);border:1px solid var(--border-color);box-shadow:none}.view-toggle-btn.active,.filter-btn.active,.filter-btn.success.active,.filter-btn.danger.active,.severity-filter-btn.active{background:#eaf1df;border-color:#9db67a;color:#385800}.severity-filter-group{margin-left:auto}.skills-summary-bar{background:transparent;border:0;padding:10px 0;margin-bottom:12px;font-size:11px}.section-header{font-size:14px;letter-spacing:-.1px}.skill-card,.validator-card{border:1px solid var(--border-color);box-shadow:none;margin-bottom:10px;border-radius:8px;background:var(--bg)}.skill-header{padding:15px 18px;background:var(--bg);gap:14px}.skill-name{font-size:13px;overflow-wrap:anywhere;min-width:0;font-weight:600}.skill-checks-summary{font-size:10px;flex-wrap:wrap;gap:7px}.skill-checks-summary .status-badge{font-size:10px}.status-badge{font-size:10px;border-radius:4px;padding:3px 7px;text-transform:none}.skill-content.active{max-height:none;padding:18px;border-top:1px solid var(--border-color)}.validator-collapsible{padding:14px 18px;background:var(--bg);font-size:12px;gap:12px;text-align:left}.validator-content.active{max-height:none;padding:18px}.validator-name{font-size:13px}.check-finding{box-shadow:none;border-radius:5px}.quality-score-block{background:var(--bg-secondary)!important}.quality-score-block strong{font-size:14px!important}.finding-message{font-size:12px}.finding-suggestion{font-size:11px}.finding-suggestion.truncatable{max-height:none;overflow:visible;cursor:auto}.summary-table-wrapper,.top-issues-content,.contributor-content{overflow-x:auto}.skill-card,.validator-card{scroll-margin-top:20px}footer{margin-left:0;padding:20px 40px;border-top:1px solid var(--border-color);font-size:10px;background:var(--bg);text-align:center}#backToTop{background:#303b28;color:white;border-radius:6px;box-shadow:none}
[data-theme="dark"]{--light-bg:#151a1f;--bg:#1e252c;--bg-secondary:#252d35;--bg-tertiary:#303b46;--dark-text:#e1e6eb;--text-secondary:#aab5bf;--border-color:#3b454f;--success-color:#a2cf72;--danger-color:#ffadb1;--warning-color:#e7c778;--secondary-color:#b0d684;--badge-pass-bg:#293e27;--badge-pass-tx:#c4e7a0;--badge-fail-bg:#412a2d;--badge-fail-tx:#ffc1c4;--badge-warn-bg:#403826;--badge-warn-tx:#f4d792}[data-theme="dark"] .filter-btn.active,[data-theme="dark"] .severity-filter-btn.active,[data-theme="dark"] .view-toggle-btn.active{background:#344a2e;color:#d4e9c2}
@media(min-width:1600px){.container{padding-top:40px}}@media(max-width:1150px){body{padding-left:180px}.report-sidebar{width:180px}.report-sidebar .sidebar-brand{font-size:13px;gap:7px}.brand-mark{width:25px}.container{padding:25px}.header-content{padding:0 25px}.header-status-badge{display:none}.dashboard-card{min-width:110px;padding:0 12px}.agent-hero-title{font-size:25px}.top-issues-table th,.top-issues-table td{padding:10px}.severity-filter-group{margin-left:0}}
@media(max-width:760px){body{padding-left:0}.report-sidebar{position:relative;width:100%;padding:13px 18px;flex-direction:row;align-items:center;gap:6px;flex-wrap:wrap}.report-sidebar .sidebar-brand{padding:0;margin-right:auto;font-size:14px}.sidebar-brand small,.sidebar-label,.sidebar-footer,.report-sidebar>a:not(.sidebar-brand){display:none}.main-header{padding:10px 0}.header-content{padding:0 18px;gap:8px}.logo-section{display:none}.header-meta{width:100%;justify-content:space-between}.header-controls{width:100%;justify-content:flex-end}.header-controls button{min-height:36px}.container{padding:20px 16px 40px}.agent-hero{padding:20px}.agent-hero-top{display:block}.agent-hero-title{font-size:25px}.agent-hero-score.verdict-text,.agent-hero-score,.agent-hero-detail,.verdict-caption{text-align:left}.agent-hero-score.verdict-text{margin-top:22px;font-size:22px}.agent-hero-detail{margin-top:8px}.verdict-caption{margin-bottom:5px}.tier-cards{display:block}.tier-card{margin-top:8px;min-width:0}.tier-card-stats{display:flex;flex-wrap:wrap;gap:8px}.scope-strip{gap:6px 12px;font-size:10px}.scope-strip span+span{padding-left:0;border:0}.scope-strip span:first-child{width:100%}.metadata-grid{grid-template-columns:1fr}.dashboard{gap:16px 0}.dashboard-card{min-width:45%;padding-left:14px}.dashboard-card:nth-child(2n){border-right:0}.dashboard-card-value{font-size:20px}.report-searchbar input{width:100%;flex-basis:100%;order:2}.report-searchbar label{flex:1}.report-searchbar #report-search-count{order:3}.filter-group{gap:6px}.filter-group .severity-filter-group{width:100%;padding-top:8px}.skill-header{display:block;padding:14px}.skill-name{font-size:12px;word-break:break-word}.skill-checks-summary{margin-top:12px}.skill-content.active{padding:12px}.top-issues-table{min-width:620px}.quality-score-block>div:first-child{flex-wrap:wrap;gap:8px}.validator-collapsible{flex-wrap:wrap}.workspace-heading h2{font-size:18px}.workspace-heading p{font-size:11px}.skip-link{left:10px}footer{padding:18px;font-size:9px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
@media print{body{padding-left:0;background:#fff;color:#111}.report-sidebar,.main-header,.report-searchbar,.filter-group,.view-toggle-section,#backToTop,.report-no-matches{display:none!important}.container{max-width:none;padding:0}.tab-content,.results-view,.skill-card,.validator-card,.skill-content,.validator-content,.top-issues-content,.contributor-content,.summary-table-container{display:block!important;max-height:none!important;height:auto!important;overflow:visible!important}.skill-card,.validator-card,.top-issues-section{break-inside:auto}.skill-content,.validator-content{padding:12px!important}.scope-strip,.run-metadata{font-size:10px}.agent-hero{padding:15px}.run-metadata>.metadata-grid{display:grid!important}.finding-suggestion{max-height:none!important}footer{padding:12px}.dashboard-card{min-width:100px}.top-issues-table{min-width:0}.report-breadcrumb{margin-bottom:8px}a{color:inherit}}

.quality-outcome-note{font-size:11px;color:var(--text-secondary);margin-bottom:12px}.export-btn{text-decoration:none}

.incomplete-notice,.scan-diagnostic{font-size:12px;line-height:1.6;margin:0 0 10px;padding:10px 12px;background:var(--badge-warn-bg);color:var(--badge-warn-tx);border-radius:5px;overflow-wrap:anywhere}
.agent-hero-title-block,.agent-hero-top>div,.skill-checks-summary,.check-result,.check-header>div,.report-searchbar>*{min-width:0}.quality-score-block{max-width:100%;overflow-x:auto}.check-header{flex-wrap:wrap;gap:8px}.check-details{min-width:0}.check-name,.check-description,.finding-msg,.finding-meta{overflow-wrap:anywhere}
@media(max-width:400px){.view-toggle-section{flex-wrap:wrap}.bulk-action-btn,.filter-btn{padding:7px 9px}.severity-filter-group{gap:4px}.severity-filter-btn{padding:6px}.quality-score-block{padding:12px!important}.skill-checks-grid{grid-template-columns:minmax(0,1fr)!important}.agent-hero{padding:16px}}

.advisory-findings{border-color:var(--border-color)}.advisory-findings .top-issues-header{background:var(--bg-secondary);color:var(--dark-text)}

.findings-overflow-note{padding:12px 16px;font-size:11px;color:var(--text-secondary);border-top:1px solid var(--border-color)}
details.check-result>summary{cursor:pointer;list-style:none;margin-bottom:0}details.check-result>summary::-webkit-details-marker{display:none}details.check-result>summary::before{content:'›';font-size:18px;color:var(--text-secondary);margin-right:4px}details.check-result[open]>summary::before{content:'⌄'}details.check-result .check-details{padding-top:12px}details.check-result:not([open]){padding-bottom:14px}
@media print{details.check-result>div{display:block!important;content-visibility:visible!important}}

.check-label{min-width:0;flex:1}
@media print{details::details-content{content-visibility:visible!important;height:auto!important}}

.gate-policy{display:flex;flex-wrap:wrap;gap:8px 18px;font-size:11px;color:var(--text-secondary);padding:0 2px 18px}.gate-policy strong{color:var(--dark-text);font-weight:600}
