.advisory-findings{border-color:var(--border-color)}.advisory-findings .top-issues-header{background:var(--bg-secondary);color:var(--dark-text)}

.findings-overflow-note{padding:12px 16px;font-size:11px;color:var(--text-secondary);border-top:1px solid var(--border-color)}
details.check-result>summary{cursor:pointer;list-style:none;margin-bottom:0}details.check-result>summary::-webkit-details-marker{display:none}details.check-result>summary::before{content:'›';font-size:18px;color:var(--text-secondary);margin-right:4px}details.check-result[open]>summary::before{content:'⌄'}details.check-result .check-details{padding-top:12px}details.check-result:not([open]){padding-bottom:14px}
@media print{details.check-result>div{display:block!important;content-visibility:visible!important}}

