{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skillevaluator:schema:execution_ledger_v1.schema.json",
  "title": "SkillEvaluator Execution Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_plan_digest", "reward_contract_digest", "job_evidence", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_plan_digest": {"$ref": "#/$defs/digest"},
    "reward_contract_digest": {"$ref": "#/$defs/digest"},
    "job_evidence": {
      "type": "array", "maxItems": 100000,
      "items": {"$ref": "#/$defs/job_evidence"}
    },
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 1000000,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relative_ref": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["agent", "arm", "case_id", "ordinal"],
      "properties": {
        "agent": {"$ref": "#/$defs/identity"},
        "arm": {"enum": ["with_skill", "baseline"]},
        "case_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "job_evidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "job_id", "job_name", "agent", "arm", "schedule_ref",
        "schedule_file_digest", "results_ref", "results_file_digest"
      ],
      "properties": {
        "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "job_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "agent": {"$ref": "#/$defs/identity"},
        "arm": {"enum": ["with_skill", "baseline"]},
        "schedule_ref": {"$ref": "#/$defs/relative_ref"},
        "schedule_file_digest": {"$ref": "#/$defs/digest"},
        "results_ref": {"$ref": "#/$defs/relative_ref"},
        "results_file_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "stage", "reason_code", "origin", "evidence_ref", "evidence_file_digest"],
      "properties": {
        "scope": {"enum": ["run", "agent"]},
        "stage": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "origin": {"enum": ["trusted_preflight", "harbor_pre_instruction_phase", "trusted_adapter_marker", "run_scope"]},
        "agent": {"$ref": "#/$defs/identity"},
        "evidence_ref": {"$ref": "#/$defs/relative_ref"},
        "evidence_file_digest": {"$ref": "#/$defs/digest"}
      },
      "oneOf": [
        {
          "required": ["agent"],
          "properties": {"scope": {"const": "agent"}},
          "allOf": [
            {"$ref": "#/$defs/agent_failure_taxonomy"},
            {
              "if": {"properties": {"origin": {"const": "trusted_preflight"}}},
              "then": {"properties": {"stage": {"enum": ["agent_readiness", "preflight"]}}}
            },
            {
              "if": {"properties": {"origin": {"const": "harbor_pre_instruction_phase"}}},
              "then": {"properties": {"stage": {"const": "agent_adapter_bootstrap"}, "reason_code": {"const": "adapter_initialization_failed"}}}
            },
            {
              "if": {"properties": {"origin": {"const": "trusted_adapter_marker"}}},
              "then": {
                "oneOf": [
                  {"properties": {"stage": {"const": "agent_adapter_bootstrap"}, "reason_code": {"enum": ["adapter_initialization_failed", "adapter_model_protocol_negotiation_failed"]}}},
                  {"properties": {"stage": {"const": "agent_process_bootstrap"}, "reason_code": {"enum": ["process_spawn_failed", "process_start_timeout"]}}},
                  {"properties": {"stage": {"const": "agent_authentication"}, "reason_code": {"const": "agent_authentication_failed"}}},
                  {"properties": {"stage": {"const": "transport_before_semantic_event"}, "reason_code": {"enum": ["transport_connection_failed", "transport_timeout", "model_rate_limited"]}}}
                ]
              }
            },
            {"not": {"properties": {"origin": {"const": "run_scope"}}}}
          ]
        },
        {
          "properties": {"scope": {"const": "run"}, "origin": {"const": "run_scope"}},
          "not": {"required": ["agent"]},
          "allOf": [{"$ref": "#/$defs/run_failure_taxonomy"}]
        }
      ]
    },
    "agent_failure_taxonomy": {
      "oneOf": [
        {"properties": {"stage": {"const": "agent_readiness"}, "reason_code": {"enum": ["adapter_unavailable", "model_unavailable", "agent_authentication_unavailable", "gateway_configuration_invalid"]}}},
        {"properties": {"stage": {"const": "preflight"}, "reason_code": {"enum": ["agent_runtime_unavailable", "model_not_available", "gateway_configuration_invalid"]}}},
        {"properties": {"stage": {"const": "agent_adapter_bootstrap"}, "reason_code": {"enum": ["adapter_initialization_failed", "adapter_model_protocol_negotiation_failed"]}}},
        {"properties": {"stage": {"const": "agent_process_bootstrap"}, "reason_code": {"enum": ["process_spawn_failed", "process_start_timeout"]}}},
        {"properties": {"stage": {"const": "agent_authentication"}, "reason_code": {"const": "agent_authentication_failed"}}},
        {"properties": {"stage": {"const": "transport_before_semantic_event"}, "reason_code": {"enum": ["transport_connection_failed", "transport_timeout", "model_rate_limited"]}}}
      ]
    },
    "run_failure_taxonomy": {
      "oneOf": [
        {"properties": {"stage": {"const": "policy_validation"}, "reason_code": {"enum": ["invalid_policy", "policy_validation_failed"]}}},
        {"properties": {"stage": {"const": "dataset_validation"}, "reason_code": {"enum": ["missing_dataset", "invalid_dataset", "dataset_validation_failed"]}}},
        {"properties": {"stage": {"const": "task_generation"}, "reason_code": {"enum": ["task_generation_failed", "staged_task_collision"]}}},
        {"properties": {"stage": {"const": "preflight"}, "reason_code": {"enum": ["preflight_failed", "shared_environment_failure"]}}},
        {"properties": {"stage": {"const": "execution"}, "reason_code": {"enum": ["execution_failed", "shared_configuration_invalid", "evidence_integrity_failure", "evidence_production_failure", "unsatisfied_required_agent", "post_skill_unscored_failure"]}}},
        {"properties": {"stage": {"const": "verifier"}, "reason_code": {"enum": ["grader_contract_failure", "verifier_contract_failure"]}}},
        {"properties": {"stage": {"const": "manifest_validation"}, "reason_code": {"enum": ["corrupt_manifest", "contradictory_manifest"]}}},
        {"properties": {"stage": {"const": "security"}, "reason_code": {"const": "evaluation_integrity_failure"}}}
      ]
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "agent", "arm", "case_id", "ordinal", "disposition", "trial_ref",
        "trial_file_digest", "passed", "score", "failure", "caused_by"
      ],
      "properties": {
        "agent": {"$ref": "#/$defs/identity"},
        "arm": {"enum": ["with_skill", "baseline"]},
        "case_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000},
        "disposition": {
          "enum": [
            "scored", "failed", "skipped_stop_on_pass",
            "not_run_agent_excluded", "not_run_agent_unavailable",
            "not_run_run_blocked"
          ]
        },
        "trial_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/relative_ref"}]},
        "trial_file_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "passed": {"type": ["boolean", "null"]},
        "score": {"type": ["number", "null"]},
        "failure": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/failure"}]},
        "caused_by": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/attempt"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "scored"}}},
          "then": {
            "properties": {
              "trial_ref": {"$ref": "#/$defs/relative_ref"},
              "trial_file_digest": {"$ref": "#/$defs/digest"},
              "passed": {"type": "boolean"},
              "score": {"type": "number"},
              "failure": {"type": "null"},
              "caused_by": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "failed"}}},
          "then": {
            "properties": {
              "trial_ref": {"$ref": "#/$defs/relative_ref"},
              "trial_file_digest": {"$ref": "#/$defs/digest"},
              "passed": {"type": "null"}, "score": {"type": "null"},
              "failure": {"$ref": "#/$defs/failure"},
              "caused_by": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "not_run_agent_unavailable"}}},
          "then": {
            "properties": {
              "trial_ref": {"type": "null"}, "trial_file_digest": {"type": "null"},
              "passed": {"type": "null"}, "score": {"type": "null"},
              "failure": {"type": "null"}, "caused_by": {"$ref": "#/$defs/attempt"}
            }
          }
        },
        {
          "if": {"properties": {"disposition": {"enum": ["skipped_stop_on_pass", "not_run_agent_excluded", "not_run_run_blocked"]}}},
          "then": {
            "properties": {
              "trial_ref": {"type": "null"}, "trial_file_digest": {"type": "null"},
              "passed": {"type": "null"}, "score": {"type": "null"},
              "failure": {"type": "null"}, "caused_by": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
