{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skillevaluator:schema:harbor_schedule_v1.schema.json",
  "title": "SkillEvaluator Harbor Schedule Sidecar v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_digest", "job_id", "job_name", "agent", "arm", "resolved_model", "harbor_model", "reward_contract_digest", "task_set_digest", "trials"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "job_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "agent": {"$ref": "#/$defs/identity"},
    "arm": {"enum": ["with_skill", "baseline"]},
    "resolved_model": {"type": "string", "minLength": 1, "maxLength": 1024},
    "harbor_model": {"type": "string", "minLength": 1, "maxLength": 1024},
    "reward_contract_digest": {"$ref": "#/$defs/digest"},
    "task_set_digest": {"$ref": "#/$defs/digest"},
    "trials": {
      "type": "array", "minItems": 1, "maxItems": 1000000,
      "items": {"$ref": "#/$defs/trial"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "trial": {
      "type": "object", "additionalProperties": false,
      "required": ["trial_name", "agent", "arm", "case_id", "ordinal", "reward_strategy", "staged_task_digest"],
      "properties": {
        "trial_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "agent": {"$ref": "#/$defs/identity"},
        "arm": {"enum": ["with_skill", "baseline"]},
        "case_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000},
        "reward_strategy": {"enum": ["single_step", "multi_step_mean", "multi_step_final"]},
        "staged_task_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
