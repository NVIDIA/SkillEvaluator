        "requested_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Model"
        },
        "resolved_model": {
          "title": "Resolved Model",
          "type": "string"
        },
        "score_eligible": {
          "title": "Score Eligible",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/AgentValidityStatus"
        },
        "viewer_url": {
          "anyOf": [
            {
              "maxLength": 4096,
              "pattern": "^https?://",
              "type": "string"
