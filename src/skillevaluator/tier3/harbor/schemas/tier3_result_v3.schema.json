        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "invalid_policy",
                "policy_validation_failed",
                "missing_dataset",
                "invalid_dataset",
                "dataset_validation_failed",
                "task_generation_failed",
                "staged_task_collision",
                "preflight_failed",
                "shared_environment_failure",
                "execution_failed",
                "shared_configuration_invalid",
                "evidence_integrity_failure",
                "evidence_production_failure",
                "unsatisfied_required_agent",
                "post_skill_unscored_failure",
                "grader_contract_failure",
                "verifier_contract_failure",
                "corrupt_manifest",
                "contradictory_manifest",
                "evaluation_integrity_failure",
                "adapter_unavailable",
                "model_unavailable",
                "agent_authentication_unavailable",
                "gateway_configuration_invalid",
                "agent_runtime_unavailable",
                "model_not_available",
                "adapter_initialization_failed",
                "adapter_model_protocol_negotiation_failed",
                "process_spawn_failed",
                "process_start_timeout",
                "agent_authentication_failed",
                "transport_connection_failed",
                "transport_timeout",
                "model_rate_limited",
                "agent_execution_timeout",
                "agent_process_exit"
