        "failure_stage": {
          "anyOf": [
            {
              "enum": [
                "policy_validation",
                "dataset_validation",
                "task_generation",
                "preflight",
                "agent_readiness",
                "agent_adapter_bootstrap",
                "agent_process_bootstrap",
                "agent_authentication",
                "transport_before_semantic_event",
